index ee0584e4..914e1ef2 100644
--- a/core/iwasm/common/arch/invokeNative_general.c
+++ b/core/iwasm/common/arch/invokeNative_general.c
@@ -132,6 +132,77 @@ invokeNative(void (*native_code)(), uint32 argv[], uint32 argc)
 #endif
 }
 
+#if defined(__EMSCRIPTEN__)
+static uint64
+read_uint64(const uint32 argv[], uint32 index)
+{
+    return ((uint64)argv[index + 1] << 32) | argv[index];
+}
+
+bool
+invokeNative_browser_i64(void (*native_code)(), uint32 argv[], uint32 argc,
+                         const char *signature, uint32 *result)
+{
+    if (strcmp(signature, "(iI*)i") == 0 && argc == 5) {
+        typedef uint32 (*NativeFunc)(uint32, uint32, uint64, uint32);
+        *result = ((NativeFunc)native_code)(argv[0], argv[1],
+                                           read_uint64(argv, 2), argv[4]);
+    }
+    else if (strcmp(signature, "(i*iI*)i") == 0 && argc == 7) {
+        typedef uint32 (*NativeFunc)(uint32, uint32, uint32, uint32, uint64,
+                                     uint32);
+        *result = ((NativeFunc)native_code)(
+            argv[0], argv[1], argv[2], argv[3], read_uint64(argv, 4), argv[6]);
+    }
+    else if (strcmp(signature, "(iIi*)i") == 0 && argc == 6) {
+        typedef uint32 (*NativeFunc)(uint32, uint32, uint64, uint32, uint32);
+        *result = ((NativeFunc)native_code)(
+            argv[0], argv[1], read_uint64(argv, 2), argv[4], argv[5]);
+    }
+    else if (strcmp(signature, "(iII)i") == 0 && argc == 6) {
+        typedef uint32 (*NativeFunc)(uint32, uint32, uint64, uint64);
+        *result = ((NativeFunc)native_code)(
+            argv[0], argv[1], read_uint64(argv, 2), read_uint64(argv, 4));
+    }
+    else if (strcmp(signature, "(iIIi)i") == 0 && argc == 7) {
+        typedef uint32 (*NativeFunc)(uint32, uint32, uint64, uint64, uint32);
+        *result = ((NativeFunc)native_code)(
+            argv[0], argv[1], read_uint64(argv, 2), read_uint64(argv, 4),
+            argv[6]);
+    }
+    else if (strcmp(signature, "(ii*~iIIi*)i") == 0 && argc == 12) {
+        typedef uint32 (*NativeFunc)(uint32, uint32, uint32, uint32, uint32,
+                                     uint32, uint64, uint64, uint32, uint32);
+        *result = ((NativeFunc)native_code)(
+            argv[0], argv[1], argv[2], argv[3], argv[4], argv[5],
+            read_uint64(argv, 6), read_uint64(argv, 8), argv[10], argv[11]);
+    }
+    else if (strcmp(signature, "(i*~I*)i") == 0 && argc == 7) {
+        typedef uint32 (*NativeFunc)(uint32, uint32, uint32, uint32, uint64,
+                                     uint32);
+        *result = ((NativeFunc)native_code)(
+            argv[0], argv[1], argv[2], argv[3], read_uint64(argv, 4), argv[6]);
+    }
+    else if (strcmp(signature, "(iI)i") == 0 && argc == 4) {
+        typedef uint32 (*NativeFunc)(uint32, uint32, uint64);
+        *result = ((NativeFunc)native_code)(argv[0], argv[1],
+                                           read_uint64(argv, 2));
+    }
+    else if (strcmp(signature, "(ii*~IIi)i") == 0 && argc == 10) {
+        typedef uint32 (*NativeFunc)(uint32, uint32, uint32, uint32, uint32,
+                                     uint64, uint64, uint32);
+        *result = ((NativeFunc)native_code)(
+            argv[0], argv[1], argv[2], argv[3], argv[4],
+            read_uint64(argv, 5), read_uint64(argv, 7), argv[9]);
+    }
+    else {
+        return false;
+    }
+
+    return true;
+}
+#endif
+
 #if defined(__clang__)
 #pragma clang diagnostic pop
 #endif
