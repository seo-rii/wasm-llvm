{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://wasm-llvm.invalid/contracts/lldb-browser/debug-manifest.schema.json",
	"title": "wasm-llvm LLDB browser artifact manifest",
	"type": "object",
	"additionalProperties": false,
	"required": ["manifestVersion", "version", "debugger"],
	"properties": {
		"manifestVersion": { "const": 1 },
		"version": { "type": "string", "minLength": 1 },
		"debugger": {
			"type": "object",
			"additionalProperties": false,
			"required": ["protocolVersion", "lldb", "transport", "capabilities"],
			"properties": {
				"protocolVersion": { "const": 1 },
				"lldb": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"js",
						"wasm",
						"worker",
						"sha256",
						"jsSha256",
						"wasmSha256",
						"workerSha256",
						"wasmCompression",
						"llvmVersion",
						"llvmRevision",
						"patchesSha256"
					],
					"properties": {
						"js": { "const": "lldb-web-dap.js" },
						"wasm": { "const": "lldb-web-dap.wasm" },
						"worker": { "const": "lldb-web-dap.pthread.mjs" },
						"sha256": { "$ref": "#/$defs/sha256" },
						"jsSha256": { "$ref": "#/$defs/sha256" },
						"wasmSha256": { "$ref": "#/$defs/sha256" },
						"workerSha256": { "$ref": "#/$defs/sha256" },
						"wasmCompression": { "const": "none" },
						"llvmVersion": { "const": "22.1.8" },
						"llvmRevision": {
							"const": "ca7933e47d3a3451d81e72ac174dcb5aa28b59d1"
						},
						"patchesSha256": { "$ref": "#/$defs/sha256" }
					}
				},
				"transport": {
					"type": "object",
					"additionalProperties": false,
					"required": ["scheme", "contract", "requiresSharedArrayBuffer"],
					"properties": {
						"scheme": { "const": "wasm-messageport" },
						"contract": { "const": "shared-ring-v1" },
						"requiresSharedArrayBuffer": { "const": true }
					}
				},
				"capabilities": {
					"type": "object",
					"additionalProperties": { "type": "boolean" }
				}
			}
		}
	},
	"$defs": {
		"sha256": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		}
	}
}
