index 319c5e262..60dc28024 100644
--- a/lldb/source/Plugins/Process/wasm/UnwindWasm.cpp
+++ b/lldb/source/Plugins/Process/wasm/UnwindWasm.cpp
@@ -65,7 +65,10 @@ bool UnwindWasm::DoGetFrameInfoAtIndex(uint32_t frame_idx, lldb::addr_t &cfa,
     return false;
 
   behaves_like_zeroth_frame = (frame_idx == 0);
-  cfa = 0;
+  // Call-depth CFAs keep Wasm frame identity stable as callees are pushed
+  // while preserving LLDB's downward-growing stack order.
+  const uint64_t call_depth = m_frames.size() - frame_idx;
+  cfa = 0xffffffffULL - call_depth;
   pc = m_frames[frame_idx];
   return true;
 }
