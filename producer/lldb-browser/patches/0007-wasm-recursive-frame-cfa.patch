+            bytes.fromhex(
+                "0000000000000000040000000300000000000000040000000300000000000000"
+            ),
+        )
+        self.server.responder = MyResponder(
+            obj_path,
+            "test_wasm",
+            call_stacks,
+            memory,
+            {
