@@ -363,6 +363,24 @@
         self.assertEqual(i, 7, "i != 7 showing post hitCondition hits every time")
 
     @skipIfWindows
+    def test_clear_hit_condition(self):
+        """Clearing a pending hit condition preserves the breakpoint ID."""
+        loop_line = line_number("main.cpp", "// break loop")
+        self.build_and_launch(self.getBuildArtifact("a.out"))
+        for expected_i, cleared in enumerate([{}, {"hitCondition": ""}]):
+            breakpoint_ids = self.set_source_breakpoints(
+                self.main_path, [loop_line], [{"hitCondition": "4"}]
+            )
+            cleared_ids = self.set_source_breakpoints(
+                self.main_path, [loop_line], [cleared]
+            )
+            self.assertEqual(breakpoint_ids, cleared_ids)
+            self.continue_to_breakpoints(breakpoint_ids)
+            self.assertEqual(
+                int(self.dap_server.get_local_variable_value("i")), expected_i
+            )
+
