--- a/lldb/source/Plugins/Process/wasm/RegisterContextWasm.cpp
+++ b/lldb/source/Plugins/Process/wasm/RegisterContextWasm.cpp
@@ -64,6 +64,19 @@
 
 bool RegisterContextWasm::ReadRegister(const RegisterInfo *reg_info,
                                        RegisterValue &value) {
+  if (reg_info->name && m_concrete_frame_idx != 0 &&
+      reg_info->kinds[eRegisterKindGeneric] == LLDB_REGNUM_GENERIC_PC) {
+    // A caller's PC is its raw return address, already present in the Wasm
+    // unwind snapshot. A remote p packet only reads the live thread's PC.
+    // Use the unwinder's stop-scoped cache rather than retaining another copy:
+    // it is cleared even for internal stops during a source-level step.
+    addr_t pc = LLDB_INVALID_ADDRESS;
+    auto &thread = static_cast<ThreadWasm &>(GetThread());
+    if (!thread.GetWasmFramePC(m_concrete_frame_idx, pc))
+      return false;
+    return value.SetUInt(pc, reg_info->byte_size);
+  }
+
   // The only real registers is the PC.
   if (reg_info->name)
     return GDBRemoteRegisterContext::ReadRegister(reg_info, value);
