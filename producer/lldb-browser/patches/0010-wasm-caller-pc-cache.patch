+bool ThreadWasm::GetWasmFramePC(uint32_t concrete_frame_idx, lldb::addr_t &pc) {
+  lldb::addr_t cfa = LLDB_INVALID_ADDRESS;
+  bool behaves_like_zeroth_frame = false;
+  return GetUnwinder().GetFrameInfoAtIndex(concrete_frame_idx, cfa, pc,
+                                        behaves_like_zeroth_frame);
+}
