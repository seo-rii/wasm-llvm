diff --git a/clang/test/DebugInfo/WebAssembly/function-end-location.c b/clang/test/DebugInfo/WebAssembly/function-end-location.c
new file mode 100644
--- /dev/null
+++ b/clang/test/DebugInfo/WebAssembly/function-end-location.c
@@ -0,0 +1,61 @@
+// RUN: %clang_cc1 -triple wasm32-unknown-wasi -O0 -emit-llvm -debug-info-kind=limited -gno-column-info %s -o - | FileCheck %s --check-prefixes=COMMON,WASM
+// RUN: %clang_cc1 -triple wasm64-unknown-wasi -O0 -emit-llvm -debug-info-kind=limited -gno-column-info %s -o - | FileCheck %s --check-prefixes=COMMON,WASM
+// RUN: %clang_cc1 -triple x86_64-unknown-linux-gnu -O0 -emit-llvm -debug-info-kind=limited -gno-column-info %s -o - | FileCheck %s --check-prefixes=COMMON,NATIVE
+// RUN: %clang_cc1 -triple wasm32-unknown-wasi -O1 -emit-llvm -debug-info-kind=limited -gno-column-info %s -o - | FileCheck %s --check-prefix=OPT
+// RUN: %clang_cc1 -triple wasm32-unknown-wasi -O0 -emit-llvm %s -o - | FileCheck %s --check-prefix=NODEBUG
+
+// A function-end stop belongs to a real epilogue instruction in this function.
+// Only unoptimized Wasm debug code changes. Native and optimized return
+// locations remain at the return expression, and nodebug code gains no debug
+// locations or extra instructions.
+
+// COMMON-LABEL: define{{.*}} i32 @value(
+// WASM: ret i32 {{.*}}, !dbg ![[VALUE_END:[0-9]+]]
+// NATIVE: ret i32 {{.*}}, !dbg ![[VALUE_RET:[0-9]+]]
+// OPT-LABEL: define{{.*}} i32 @value(
+// OPT: ret i32 {{.*}}, !dbg ![[OPT_RET:[0-9]+]]
+#line 100
+int value(int n) {
+  int answer = n + 10;
+  return answer;
+}
+
+// COMMON-LABEL: define{{.*}} i32 @branches(
+// WASM: ret i32 {{.*}}, !dbg ![[BRANCH_END:[0-9]+]]
+#line 200
+int branches(int n) {
+  if (n)
+    return n;
+  return 0;
+}
+
+// COMMON-LABEL: define{{.*}} void @implicit(
+// WASM: ret void, !dbg ![[VOID_END:[0-9]+]]
+#line 300
+void implicit(int *out) {
+  *out = 7;
+}
+
+// COMMON-LABEL: define{{.*}} void @early_void(
+// WASM: ret void, !dbg ![[EARLY_END:[0-9]+]]
+#line 400
+void early_void(void) {
+  return;
+}
+
+// COMMON-LABEL: define{{.*}} i32 @constant(
+// WASM: ret i32 42, !dbg ![[CONST_END:[0-9]+]]
+#line 500
+int constant(void) {
+  return 42;
+}
+
+// WASM: ![[VALUE_END]] = !DILocation(line: 103,
+// NATIVE: ![[VALUE_RET]] = !DILocation(line: 102,
+// OPT: ![[OPT_RET]] = !DILocation(line: 102,
+// WASM: ![[BRANCH_END]] = !DILocation(line: 204,
+// WASM: ![[VOID_END]] = !DILocation(line: 302,
+// WASM: ![[EARLY_END]] = !DILocation(line: 402,
+// WASM: ![[CONST_END]] = !DILocation(line: 502,
+// NODEBUG-NOT: !dbg
+// NODEBUG-NOT: llvm.dbg
