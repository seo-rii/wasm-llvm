+static bool reject_wasm_object(llvm::StringRef message) {
+	llvm::errs() << "tinygo-browser-adapter: " << message << "\n";
+	return false;
+}
+
+static bool is_forbidden_native_symbol(llvm::StringRef name) {
+	if (name == "atexit" || name == "__dso_handle" ||
+		name == "__gxx_personality_v0" || name == "__clang_call_terminate" ||
+		name == "__tls_get_addr" || name == "__wasm_call_ctors" ||
+		name == "__wasm_apply_data_relocs") {
+		return true;
+	}
+	for (llvm::StringRef prefix : {
+			 "__cxa_", "__cxx_global_var_init", "__emutls_", "__tls_",
+			 "_GLOBAL__", "_Unwind_", "_ZGV", "_ZTI", "_ZTS", "_ZTV",
+			 "_ZNSt", "_ZNKSt", "_ZSt", "_Zd", "_Zn"}) {
+		if (name.starts_with(prefix)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool validate_wasm_object(const llvm::object::WasmObjectFile &object) {
+	if (!object.isRelocatableObject() || object.isSharedObject() ||
+		object.getArch() != llvm::Triple::wasm32 ||
+		object.hasUnmodeledTypes()) {
+		return reject_wasm_object("object is not a supported relocatable WebAssembly object");
+	}
+	if (object.linkingData().Version != llvm::wasm::WasmMetadataVersion ||
+		!object.linkingData().InitFunctions.empty()) {
+		return reject_wasm_object("invalid linking metadata or initialization functions");
+	}
+	if (!object.exports().empty() || object.startFunction() != UINT32_MAX ||
+		!object.tags().empty()) {
+		return reject_wasm_object("executable exports, start functions, and tags are forbidden");
+	}
+	for (const auto &feature : object.getTargetFeatures()) {
+		bool allowed = false;
+		if (feature.Prefix == llvm::wasm::WASM_FEATURE_PREFIX_USED) {
+			allowed = feature.Name == "bulk-memory" ||
+				feature.Name == "bulk-memory-opt" ||
+				feature.Name == "call-indirect-overlong" ||
+				feature.Name == "mutable-globals" ||
+				feature.Name == "nontrapping-fptoint" ||
+				feature.Name == "sign-ext";
+		} else if (feature.Prefix == llvm::wasm::WASM_FEATURE_PREFIX_DISALLOWED) {
+			allowed = feature.Name == "multivalue" ||
+				feature.Name == "reference-types";
+		}
+		if (!allowed) {
+			return reject_wasm_object("WebAssembly target feature is outside the strict allowlist");
+		}
+	}
+	constexpr unsigned allowedLimitsFlags = llvm::wasm::WASM_LIMITS_FLAG_HAS_MAX;
+	auto memoryCount = object.memories().size();
+	auto tableCount = object.tables().size();
+	for (const auto &memory : object.memories()) {
+		if (memory.Flags & ~allowedLimitsFlags) {
+			return reject_wasm_object("unsupported defined-memory limits flags");
+		}
+	}
+	for (const auto &table : object.tables()) {
+		if (table.Type.Limits.Flags & ~allowedLimitsFlags) {
+			return reject_wasm_object("unsupported defined-table limits flags");
+		}
+	}
+	for (const auto &import : object.imports()) {
+		if (import.Kind == llvm::wasm::WASM_EXTERNAL_TAG) {
+			return reject_wasm_object("exception tag imports are forbidden");
+		}
+		if (import.Kind == llvm::wasm::WASM_EXTERNAL_MEMORY) {
+			memoryCount++;
+			if (import.Memory.Flags & ~allowedLimitsFlags) {
+				return reject_wasm_object("unsupported imported-memory limits flags");
+			}
+		}
+		if (import.Kind == llvm::wasm::WASM_EXTERNAL_TABLE) {
+			tableCount++;
+			if (import.Table.Limits.Flags & ~allowedLimitsFlags) {
+				return reject_wasm_object("unsupported imported-table limits flags");
+			}
+		}
+	}
+	if (memoryCount > 1 || tableCount > 1) {
+		return reject_wasm_object("at most one total memory and one total table are allowed");
+	}
+	for (const auto &segment : object.dataSegments()) {
+		if ((segment.Data.LinkingFlags & llvm::wasm::WASM_SEG_FLAG_TLS) ||
+			segment.Data.Name.starts_with(".preinit_array") ||
+			segment.Data.Name.starts_with(".init_array") ||
+			segment.Data.Name.starts_with(".fini_array") ||
+			segment.Data.Name.starts_with(".ctors") ||
+			segment.Data.Name.starts_with(".dtors")) {
+			return reject_wasm_object("TLS and initializer/finalizer data segments are forbidden");
+		}
+	}
+	for (const llvm::object::SymbolRef &symbol : object.symbols()) {
+		const auto &wasmSymbol = object.getWasmSymbol(symbol);
+		if ((wasmSymbol.Info.Flags & llvm::wasm::WASM_SYMBOL_TLS) ||
+			(wasmSymbol.isTypeData() && wasmSymbol.Info.Name.starts_with("_ZZ")) ||
+			is_forbidden_native_symbol(wasmSymbol.Info.Name)) {
+			return reject_wasm_object("TLS or forbidden ABI symbol is present");
+		}
+	}
+	for (const llvm::object::SectionRef &section : object.sections()) {
+		for (const auto &relocation : object.getWasmSection(section).Relocations) {
+			if (relocation.Type == llvm::wasm::R_WASM_MEMORY_ADDR_LEB64 ||
+				relocation.Type == llvm::wasm::R_WASM_MEMORY_ADDR_SLEB64 ||
+				relocation.Type == llvm::wasm::R_WASM_MEMORY_ADDR_I64 ||
+				relocation.Type == llvm::wasm::R_WASM_MEMORY_ADDR_REL_SLEB64 ||
+				relocation.Type == llvm::wasm::R_WASM_TABLE_INDEX_SLEB64 ||
+				relocation.Type == llvm::wasm::R_WASM_TABLE_INDEX_I64 ||
+				relocation.Type == llvm::wasm::R_WASM_FUNCTION_OFFSET_I64 ||
+				relocation.Type == llvm::wasm::R_WASM_TABLE_INDEX_REL_SLEB64 ||
+				relocation.Type == llvm::wasm::R_WASM_MEMORY_ADDR_TLS_SLEB ||
+				relocation.Type == llvm::wasm::R_WASM_MEMORY_ADDR_TLS_SLEB64) {
+				return reject_wasm_object("memory64, table64, and TLS relocations are forbidden");
+			}
+		}
+	}
+	return true;
+}
+
 extern "C" {
 
+bool tinygo_validate_wasm_object(const char *path) {
+	auto buffer = llvm::MemoryBuffer::getFile(path);
+	if (!buffer) {
+		return reject_wasm_object(buffer.getError().message());
+	}
+	auto parsed = llvm::object::ObjectFile::createObjectFile((*buffer)->getMemBufferRef());
+	if (!parsed) {
+		llvm::logAllUnhandledErrors(parsed.takeError(), llvm::errs(),
+			"tinygo-browser-adapter: LLVMObject: ");
+		return false;
+	}
+	auto *object = llvm::dyn_cast<llvm::object::WasmObjectFile>(parsed->get());
+	return object != nullptr && validate_wasm_object(*object);
+}
