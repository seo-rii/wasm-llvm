+		(uintptr_t)parent.data[1],
+		(uintptr_t)parent.data[2],
+		client_data);
+}
+
+enum CXChildVisitResult tinygo_clang_struct_visitor_bridge(
+	CXCursor cursor, CXCursor parent, CXClientData client_data) {
+	return tinygo_clang_struct_visitor(
+		cursor.kind,
+		cursor.xdata,
+		(uintptr_t)cursor.data[0],
+		(uintptr_t)cursor.data[1],
+		(uintptr_t)cursor.data[2],
+		parent.kind,
+		parent.xdata,
+		(uintptr_t)parent.data[0],
+		(uintptr_t)parent.data[1],
+		(uintptr_t)parent.data[2],
+		client_data);
+}
+
+CXCursorVisitor tinygo_clang_globals_visitor_bridge_ptr(void) {
+	return tinygo_clang_globals_visitor_bridge;
+}
+
+CXCursorVisitor tinygo_clang_struct_visitor_bridge_ptr(void) {
+	return tinygo_clang_struct_visitor_bridge;
 }
