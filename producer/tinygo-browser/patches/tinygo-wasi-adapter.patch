new file mode 100644
index 0000000000000000000000000000000000000000..ff404f97ba4a0d2e475eda4dc7d070f23bfd81ed
--- /dev/null
+++ b/builder/lock_default.go
@@ -0,0 +1,18 @@
+//go:build !wasip1
+
+package builder
+
+import "github.com/gofrs/flock"
+
+// lock may acquire a lock at the specified path.
+// It returns a function to release the lock.
+// If flock is not supported, it does nothing.
+func lock(path string) func() {
+	fileLock := flock.New(path)
+	err := fileLock.Lock()
+	if err != nil {
+		return func() {}
+	}
+
+	return func() { fileLock.Close() }
+}
