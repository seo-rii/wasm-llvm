  "patch": {
    "path": "patches/llvm-wasi-c-api-config.patch",
    "sha256": "ebc6a405f6459bd141904cf488d1ac606bdfd2d75a41a5ccd3f6127e883f7d01",
    "scope": [
      "no-pthread-discovery",
      "tinygo-wasm-visibility",
      "feature-gated-setjmp",
      "wasi-rlimit-guards",
      "wasi-signal-and-process-fallbacks",
      "wasi-libclang-resource-path"
    ]
