+    private fun reportSyntaxErrors(builder: SyntaxTreeBuilder, sourceFile: KtSourceFile) {
+        val reporter = diagnosticsReporter ?: return
+        val languageSettings = session.languageVersionSettings
+        val context = object : DiagnosticContext {
+            override val containingFile: KtSourceFile = sourceFile
+            override val languageVersionSettings get() = languageSettings
+            override fun isDiagnosticSuppressed(diagnostic: KtDiagnostic): Boolean = false
+        }
+        val productions = prepareProduction(builder).productionMarkers
+        for (index in 0 until productions.size) {
+            if (productions.isDoneMarker(index)) continue
+            val marker = productions.getMarker(index)
+            if (!marker.isErrorMarker()) continue
+            reporter.reportOn(
+                KtOffsetsOnlySourceElement(marker.getStartOffset(), marker.getEndOffset()),
+                FirSyntaxErrors.SYNTAX,
+                marker.getErrorMessage().orEmpty(),
+                context,
+            )
+        }
