  "originalReadBytes": "    private inline fun <R> readBytes(transform: (offset: Int, length: Int) -> R): R {\n        val length = readInt()\n        val offset = buffer.position()\n        val result = transform(offset, length)\n        buffer.position(offset + length)\n        return result\n    }",
