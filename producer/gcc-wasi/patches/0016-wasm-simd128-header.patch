+      value = force_reg (d.vector_mode, value);
+      scalar = force_reg (inner, scalar);
+      if (!target || !wasm_register_operand (target, d.vector_mode))
+        target = gen_reg_rtx (d.vector_mode);
+      emit_move_insn (target, value);
+      create_fixed_operand (&operands[0], target);
+      create_input_operand (&operands[1], scalar, inner);
+      create_integer_operand (&operands[2], lane);
+      expand_insn (d.instruction, 3, operands);
+      return target;
+    }
+  create_output_operand (&operands[0], target, result_mode);
+  create_input_operand (&operands[1], value,
+                        d.operation == WASM_LANE_SPLAT ? inner : d.vector_mode);
+  if (d.operation == WASM_LANE_EXTRACT)
+    create_integer_operand (&operands[2], lane);
+  expand_insn (d.instruction, d.operation == WASM_LANE_SPLAT ? 2 : 3, operands);
+  return operands[0].value;
+}
