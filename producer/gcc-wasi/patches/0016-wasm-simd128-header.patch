+(define_insn "wasm_extract_u_<mode>"
+  [(set (match_operand:SI 0 "wasm_register_operand")
+        (zero_extend:SI
+          (vec_select:<VUNIT>
+            (match_operand:VSAT128 1 "wasm_register_operand")
+            (parallel [(match_operand:SI 2 "const_int_operand")]))))]
+  "TARGET_SIMD128 && UINTVAL (operands[2]) < 16 / GET_MODE_UNIT_SIZE (<MODE>mode)"
