+{
+  const wasm_lane_builtin_description &d = wasm_lane_builtins[code];
+  machine_mode inner = GET_MODE_INNER (d.vector_mode);
+  machine_mode result_mode = d.operation == WASM_LANE_EXTRACT
+    ? ((inner == QImode || inner == HImode) ? SImode : inner)
+    : d.vector_mode;
+  if (!TARGET_SIMD128)
+    {
+      error_at (EXPR_LOCATION (exp),
+                "%qs requires %<-msimd128%>; SIMD128 is disabled", d.name);
+      return CONST0_RTX (result_mode);
+    }
+  HOST_WIDE_INT lane = 0;
+  if (d.operation != WASM_LANE_SPLAT)
+    {
+      tree index = CALL_EXPR_ARG (exp, 1);
+      if (!tree_fits_shwi_p (index))
+        {
+          error_at (EXPR_LOCATION (exp), "%qs lane index must be constant",
+                    d.name);
+          return CONST0_RTX (result_mode);
+        }
+      lane = tree_to_shwi (index);
+      if (lane < 0 || lane >= GET_MODE_NUNITS (d.vector_mode).to_constant ())
+        {
+          error_at (EXPR_LOCATION (exp), "%qs lane index out of range", d.name);
+          return CONST0_RTX (result_mode);
+        }
+    }
+  rtx value = expand_normal (CALL_EXPR_ARG (exp, 0));
