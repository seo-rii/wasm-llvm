+/* A scalar view of a native v128 is a lane, not an ordinary scalar
+   local.  Generic block/bit-field expansion can create these SUBREGs even
+   when its vector mode has a different element size (e.g. a DI memcpy into
+   V4SI).  Keep the containing v128 and use a same-size lane interpretation.  */
+static machine_mode
+scalar_vector_subreg_mode (rtx value)
+{
+  if (!TARGET_SIMD128 || !SUBREG_P (value) || !REG_P (SUBREG_REG (value))
+      || !targetm.vector_mode_supported_p (GET_MODE (SUBREG_REG (value))))
+    return VOIDmode;
+  machine_mode vector_mode;
+  switch (GET_MODE (value))
+    {
+    case E_QImode: vector_mode = V16QImode; break;
+    case E_HImode: vector_mode = V8HImode; break;
+    case E_SImode: vector_mode = V4SImode; break;
+    case E_DImode: vector_mode = V2DImode; break;
+    case E_SFmode: vector_mode = V4SFmode; break;
+    case E_DFmode: vector_mode = V2DFmode; break;
+    default: return VOIDmode;
+    }
+  unsigned byte = SUBREG_BYTE (value).to_constant ();
+  unsigned size = GET_MODE_SIZE (GET_MODE (value));
+  gcc_assert (byte % size == 0 && byte + size <= 16);
+  return vector_mode;
+}
+
+static rtx
+legalize_vector_subreg_source (rtx value)
+{
+  machine_mode vector_mode = scalar_vector_subreg_mode (value);
+  if (vector_mode == VOIDmode)
+    return value;
+  machine_mode scalar_mode = GET_MODE (value);
+  rtx vector = copy_to_mode_reg (vector_mode,
+                                gen_lowpart (vector_mode, SUBREG_REG (value)));
+  unsigned lane = SUBREG_BYTE (value).to_constant ()
+                  / GET_MODE_SIZE (scalar_mode);
+  rtx scalar = gen_reg_rtx (scalar_mode);
+  rtx index = gen_rtx_PARALLEL (VOIDmode, gen_rtvec (1, GEN_INT (lane)));
+  emit_insn (gen_rtx_SET (scalar,
+                         gen_rtx_VEC_SELECT (scalar_mode, vector, index)));
+  return scalar;
+}
