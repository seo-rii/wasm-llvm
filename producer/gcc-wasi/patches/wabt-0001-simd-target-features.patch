+void BinaryWriter::WriteOpcode(Stream* stream, Opcode opcode) {
+  if (opcode.HasPrefix() && opcode.GetPrefix() == 0xfd) {
+    uses_simd128_ = true;
+    // All 0xfd opcodes >= 0x100 in this pinned WABT are relaxed SIMD.
+    uses_relaxed_simd_ |= opcode.GetCode() >= 0x100;
+  }
+  wabt::WriteOpcode(stream, opcode);
+}
+
+void BinaryWriter::WriteType(Stream* stream, Type type, const char* desc) {
+  uses_simd128_ |= type == Type::V128;
+  wabt::WriteType(stream, type, desc);
+}
+
+Result BinaryWriter::WriteTargetFeatures() {
+  std::map<std::string, uint8_t> features;
+  auto error = [](const char* reason) {
+    fprintf(stderr, "error: target_features: %s\n", reason);
+    return Result::Error;
+  };
+  auto merge = [&](const std::string& name, uint8_t prefix) {
+    auto inserted = features.emplace(name, prefix);
+    if (!inserted.second && inserted.first->second != prefix)
+      return error("conflicting feature declarations or actual SIMD use");
+    return Result::Ok;
+  };
+  // Preserve explicit feature declarations, coalesce duplicates, and reject
+  // malformed or contradictory inputs instead of writing competing sections.
+  for (const Custom& custom : module_->customs) {
+    if (custom.name != "target_features")
+      continue;
+    if (custom.data.empty())
+      return error("missing feature count");
+    const uint8_t* p = custom.data.data();
+    const uint8_t* end = p + custom.data.size();
+    uint32_t count;
+    size_t length = ReadU32Leb128(p, end, &count);
+    if (!length || count > custom.data.size())
+      return error("invalid feature count");
+    p += length;
+    for (uint32_t i = 0; i < count; ++i) {
+      if (p == end || (*p != '+' && *p != '-'))
+        return error("invalid feature prefix");
+      uint8_t prefix = *p++;
+      uint32_t size;
+      length = ReadU32Leb128(p, end, &size);
+      if (!length || size > static_cast<size_t>(end - p) - length)
+        return error("invalid feature name length");
+      p += length;
+      if (!size || !IsValidUtf8(reinterpret_cast<const char*>(p), size))
+        return error("invalid feature name");
+      CHECK_RESULT(merge(std::string(reinterpret_cast<const char*>(p), size),
+                         prefix));
+      p += size;
+    }
+    if (p != end)
+      return error("trailing feature data");
+  }
+  if (uses_simd128_)
+    CHECK_RESULT(merge("simd128", '+'));
+  if (uses_relaxed_simd_)
+    CHECK_RESULT(merge("relaxed-simd", '+'));
+  if (!features.empty()) {
+    // Emit after other custom sections, including any producers section.
+    BeginCustomSection("target_features");
+    WriteU32Leb128(stream_, features.size(), "feature count");
+    for (const auto& feature : features) {
+      stream_->WriteU8(feature.second, "feature prefix");
+      WriteStr(stream_, feature.first, "feature name", PrintChars::Yes);
+    }
+    EndSection();
+  }
+  return Result::Ok;
+}
