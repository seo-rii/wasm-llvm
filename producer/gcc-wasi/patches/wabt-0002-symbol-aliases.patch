+
+void NameResolver::ResolveAliases() {
+  Module* module = current_module_;
+  if (module->aliases_resolved)
+    return;
+  CheckDuplicateBindings(&module->alias_bindings, "alias");
+  std::vector<unsigned char> state(module->aliases.size(), 0);
+  for (const auto& alias : module->aliases) {
+    if (module->func_bindings.FindIndex(alias.name) != kInvalidIndex ||
+        module->data_symbol_bindings.FindIndex(alias.name) != kInvalidIndex)
+      PrintError(&alias.loc, "duplicate alias identifier \"%s\"",
+                 alias.name.c_str());
+  }
+  if (Failed(result_))
+    return;
+  std::function<Index(Index)> resolve = [&](Index i) -> Index {
+    auto& alias = module->aliases[i];
+    if (state[i] == 2)
+      return alias.index;
+    if (state[i] == 1) {
+      PrintError(&alias.loc, "cyclic alias definition \"%s\"", alias.name.c_str());
+      return kInvalidIndex;
+    }
+    state[i] = 1;
+    Index target = kInvalidIndex;
+    Index next = alias.target.is_name()
+                     ? module->alias_bindings.FindIndex(alias.target)
+                     : kInvalidIndex;
+    if (next != kInvalidIndex) {
+      if (module->aliases[next].kind != alias.kind)
+        PrintError(&alias.loc, "alias target has a different symbol kind");
+      else
+        target = resolve(next);
+    } else {
+      const auto& bindings = alias.kind == SymbolType::Function
+                                 ? module->func_bindings
+                                 : module->data_symbol_bindings;
+      target = bindings.FindIndex(alias.target);
+      bool defined = alias.kind == SymbolType::Function
+                         ? target < module->funcs.size() &&
+                               target >= module->num_func_imports
+                         : target < module->data_symbols.size() &&
+                               !module->data_symbols[target].imported();
+      if (!defined) {
+        PrintError(&alias.loc,
+                   "alias target must be a defined symbol of the same kind");
+        target = kInvalidIndex;
+      }
+    }
+    if (target != kInvalidIndex && alias.kind == SymbolType::Data) {
+      Address inherited = next == kInvalidIndex
+                              ? 0 : module->aliases[next].resolved_offset;
+      const auto& data = module->data_symbols[target];
+      if (inherited > data.size || alias.offset > data.size - inherited) {
+        PrintError(&alias.loc, "data alias offset exceeds the target object");
+        target = kInvalidIndex;
+      } else {
+        alias.resolved_offset = inherited + alias.offset;
+      }
+    }
+    alias.index = target;
+    state[i] = 2;
+    return target;
+  };
+  for (Index i = 0; i < module->aliases.size(); ++i)
+    resolve(i);
+  if (Failed(result_))
+    return;
+  for (const auto& alias : module->aliases) {
+    auto& bindings = alias.kind == SymbolType::Function
+                         ? module->func_bindings
+                         : module->data_symbol_bindings;
+    bindings.emplace(alias.name, Binding(alias.loc, alias.index));
+  }
+  module->aliases_resolved = true;
 }
 
