+
+Result WastParser::ParseSymbolAlias(Module* module) {
+  SymbolAlias alias;
+  alias.loc = GetLocation();
+  Consume();  // @sym.alias annotation opener.
+  if (!ParseBindVarOpt(&alias.name))
+    return ErrorExpected({"alias identifier"}, "$alias");
+  EXPECT(Lpar);
+  if (Match(TokenType::Func))
+    alias.kind = SymbolType::Function;
+  else if (Match(TokenType::Data))
+    alias.kind = SymbolType::Data;
+  else {
+    ErrorExpected({"func", "data"});
+    return Result::Error;
+  }
+  CHECK_RESULT(ParseVar(&alias.target));
+  if (auto offset = ParseSymAttrNumber(TokenType::Offset)) {
+    if (alias.kind != SymbolType::Data) {
+      Error(alias.loc, "only data aliases may specify an offset");
+      return Result::Error;
+    }
+    alias.offset = *offset;
+  }
+  EXPECT(Rpar);
+  CHECK_RESULT(ParseSymOpt(&alias, false));
+  EXPECT(Rpar);
+  if (alias.name_.empty()) {
+    Error(alias.loc, "alias requires an explicit linking symbol name");
+    return Result::Error;
+  }
+  if (alias.binding() == SymbolBinding::Weak) {
+    Error(alias.loc, "weak aliases are not supported by @sym.alias");
+    return Result::Error;
+  }
+  module->alias_bindings.emplace(alias.name,
+                                Binding(alias.loc, module->aliases.size()));
+  module->aliases.push_back(std::move(alias));
+  return Result::Ok;
+}
