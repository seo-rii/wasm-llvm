@@ -62,6 +62,21 @@
   "TARGET_SIMD128"
   "(%o0 (<lanes>.<vaddsub:opname> %i1 %i2))")
 
+;; Wasm has signed and unsigned saturating add/subtract for byte and halfword
+;; lanes only.  Standard optab names also serve GCC's SAT_ADD/SAT_SUB IFNs.
+(define_mode_iterator VSAT128 [V16QI V8HI])
+(define_code_iterator vsat [ss_plus us_plus ss_minus us_minus])
+(define_code_attr sat_optab [(ss_plus "ssadd") (us_plus "usadd")
+                            (ss_minus "sssub") (us_minus "ussub")])
+(define_code_attr sat_opcode [(ss_plus "add_sat_s") (us_plus "add_sat_u")
+                             (ss_minus "sub_sat_s") (us_minus "sub_sat_u")])
+(define_insn "<sat_optab><mode>3"
+  [(set (match_operand:VSAT128 0 "wasm_register_operand")
+        (vsat:VSAT128 (match_operand:VSAT128 1 "wasm_register_operand")
+                     (match_operand:VSAT128 2 "wasm_register_operand")))]
+  "TARGET_SIMD128"
+  "(%o0 (<lanes>.<sat_opcode> %i1 %i2))")
+
 (define_insn "mul<mode>3"
   [(set (match_operand:VIMUL128 0 "wasm_register_operand")
         (mult:VIMUL128 (match_operand:VIMUL128 1 "wasm_register_operand")
