+void
+wasm_assemble_symbol_ref (FILE *stream, rtx symbol)
+{
+  const char *name = XSTR (symbol, 0);
+  tree decl = SYMBOL_REF_DECL (symbol);
+  tree id = decl ? DECL_ASSEMBLER_NAME (decl) : maybe_get_identifier (name);
+  if (id && IDENTIFIER_TRANSPARENT_ALIAS (id))
