+/* Basic C ABI single-element aggregates have the same Wasm value type as
+   their sole scalar.  Keep this classification shared with signature output:
+   an i32 pointer/value mismatch is not detectable by the Wasm linker.  */
+bool
+wasm_abi_empty_type_p (const_tree type)
+{
+  return type && AGGREGATE_TYPE_P (type)
+    && !TREE_ADDRESSABLE (type)
+    && (TYPE_EMPTY_P (type)
+        || (TYPE_SIZE (type) && integer_zerop (TYPE_SIZE (type))));
+}
+
+const_tree
+wasm_abi_singleton_type (const_tree type)
+{
+  if (!type || TREE_ADDRESSABLE (type))
+    return NULL_TREE;
+  const_tree scalar = NULL_TREE;
+  if (TREE_CODE (type) == ARRAY_TYPE)
+    {
+      const_tree element = TREE_TYPE (type);
+      if (!TYPE_SIZE (type) || !TYPE_SIZE (element)
+          || TREE_CODE (TYPE_SIZE (type)) != INTEGER_CST
+          || TREE_CODE (TYPE_SIZE (element)) != INTEGER_CST
+          || !tree_int_cst_equal (TYPE_SIZE (type), TYPE_SIZE (element)))
+        return NULL_TREE;
+      scalar = wasm_abi_singleton_type (element);
+    }
+  else if (RECORD_OR_UNION_TYPE_P (type))
+    {
+      for (tree field = TYPE_FIELDS (type); field; field = DECL_CHAIN (field))
+        {
+          if (TREE_CODE (field) != FIELD_DECL)
+            continue;
+          const_tree field_type = TREE_TYPE (field);
+          if ((DECL_SIZE (field) && integer_zerop (DECL_SIZE (field)))
+              || (wasm_abi_empty_type_p (field_type)
+                  && TYPE_SIZE (field_type)
+                  && integer_zerop (TYPE_SIZE (field_type))))
+            continue;
+          if (scalar || !DECL_FIELD_OFFSET (field)
+              || !integer_zerop (DECL_FIELD_OFFSET (field))
+              || !integer_zerop (DECL_FIELD_BIT_OFFSET (field)))
+            return NULL_TREE;
+          scalar = wasm_abi_singleton_type (field_type);
+          if (!scalar)
+            return NULL_TREE;
+        }
+    }
+  else
+    {
+      machine_mode mode = TYPE_MODE (type);
+      if (mode == QImode || mode == HImode || mode == SImode
+          || mode == DImode || mode == SFmode || mode == DFmode)
+        return type;
+      return NULL_TREE;
+    }
+
+  /* Padding and over-alignment disqualify a singleton.  In particular, do
+     not mistake a flexible array or an aligned wrapper for its first field. */
+  if (!scalar || !TYPE_SIZE (type) || !TYPE_SIZE (scalar)
+      || TREE_CODE (TYPE_SIZE (type)) != INTEGER_CST
+      || TREE_CODE (TYPE_SIZE (scalar)) != INTEGER_CST
+      || !tree_int_cst_equal (TYPE_SIZE (type), TYPE_SIZE (scalar))
+      || TYPE_ALIGN (type) > TYPE_ALIGN (scalar))
+    return NULL_TREE;
+  return scalar;
+}
