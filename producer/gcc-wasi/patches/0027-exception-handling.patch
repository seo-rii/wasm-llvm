+/* The VM transfers the genuine exception payload and opaque reference to the
+   matching call-site block.  Separate reference locals survive nested catches;
+   GCC's normal EH pseudos carry the pointer and selector through optimizers. */
+const char *
+wasm_output_eh_call (rtx_insn *insn, rtx *operands, const char *text)
+{
+  if (!TARGET_EXCEPTION_HANDLING || !flag_exceptions)
+    return text;
+  eh_landing_pad lp = get_eh_landing_pad_from_rtx (insn);
+  eh_region region = get_eh_region_from_rtx (insn);
+  if (!lp && (!region || region->type != ERT_MUST_NOT_THROW))
+    return text;
+
+  uses_eh_tag = true;
+  unsigned id = INSN_UID (insn);
+  fprintf (asm_out_file, "(local.set $eh_saved_stack (global.get $stack))\n"
+           "(block $eh_done_%u\n"
+           " (block $eh_caught_%u (result i32 exnref)\n"
+           "  (try_table (catch_ref $__cpp_exception $eh_caught_%u)\n",
+           id, id, id);
+  output_asm_insn (text, operands);
+  fprintf (asm_out_file, "   (br $eh_done_%u))\n  (unreachable))\n", id);
+  if (lp)
+    fprintf (asm_out_file, " (local.set $eh_ref_%d)\n", lp->region->index);
+  else
+    fprintf (asm_out_file, " (drop)\n");
+  /* Receiver hard locals are also explicit output operands of the EH edge. */
+  fprintf (asm_out_file, " (local.set $eh_pointer)\n"
+           " (global.set $stack (local.get $eh_saved_stack))\n");
+
+  if (!lp)
+    {
+      tree failure = region->u.must_not_throw.failure_decl;
+      const char *name = IDENTIFIER_POINTER (DECL_ASSEMBLER_NAME (failure));
+      record_import (name, failure, false);
+      fprintf (asm_out_file, " (call $");
+      assemble_name (asm_out_file, name);
+      if (TYPE_ARG_TYPES (TREE_TYPE (failure)) != void_list_node)
+        fprintf (asm_out_file, " (local.get $eh_pointer)");
+      fprintf (asm_out_file, ")\n (unreachable)\n)\n");
+      return "";
+    }
+
+  unsigned index;
+  call_site_record_d *site;
+  for (index = 0; vec_safe_iterate (crtl->eh.call_site_record_v[0], index, &site);
+       ++index)
+    if (site->landing_pad == lp->landing_pad)
+      break;
+  gcc_assert (index < vec_safe_length (crtl->eh.call_site_record_v[0]));
+  tree context = build_decl (UNKNOWN_LOCATION, VAR_DECL,
+                             get_identifier ("__wasm_lpad_context"),
+                             build_array_type_nelts (unsigned_type_node, 3));
+  DECL_EXTERNAL (context) = 1;
+  TREE_PUBLIC (context) = 1;
+  record_import ("__wasm_lpad_context", context, false);
+  tree personality = build_decl (UNKNOWN_LOCATION, FUNCTION_DECL,
+                                 get_identifier ("_Unwind_CallPersonality"),
+                                 build_function_type_list (integer_type_node,
+                                                           ptr_type_node,
+                                                           NULL_TREE));
+  DECL_EXTERNAL (personality) = 1;
+  TREE_PUBLIC (personality) = 1;
+  record_import ("_Unwind_CallPersonality", personality, false);
+  fprintf (asm_out_file,
+           " (i32.store (i32.const 0 (@reloc data $__wasm_lpad_context)) (i32.const %u))\n"
+           " (i32.store offset=4 (i32.const 0 (@reloc data $__wasm_lpad_context)) "
+           "(i32.const 0 (@reloc data $__gcc_wasm_lsda_%u)))\n"
+           " (drop (call $_Unwind_CallPersonality (local.get $eh_pointer)))\n"
+           " (local.set $eh_filter (i32.load offset=8 "
+           "(i32.const 0 (@reloc data $__wasm_lpad_context))))\n"
+           " (local.set $control (i32.const %d))\n"
+           " (br $control)\n)\n",
+           index, current_function_funcdef_no,
+           get_cf_label (CODE_LABEL_NUMBER (lp->landing_pad)));
+  return "";
+}
+
+const char *
+wasm_output_eh_resume (rtx *operands)
+{
+  fprintf (asm_out_file, "(global.set $stack (local.get $base))\n"
+           "(throw_ref (local.get $eh_ref_%" HOST_WIDE_INT_PRINT "d))\n",
+           INTVAL (operands[0]));
+  return "";
+}
+
+const char *
+wasm_output_eh_copy (rtx *operands)
+{
+  fprintf (asm_out_file,
+           "(local.set $eh_ref_%" HOST_WIDE_INT_PRINT "d "
+           "(local.get $eh_ref_%" HOST_WIDE_INT_PRINT "d))\n",
+           INTVAL (operands[0]), INTVAL (operands[1]));
+  return "";
+}
+
+/* This is GNU's genuine action/type table, with indexed call-site pairs in
+   place of native-PC ranges.  The runtime consumes the same ULEB/SLEB encodings
+   and reverse RTTI table; only the VM's call-site lookup differs. */
+bool
+wasm_output_exception_table (int section)
+{
+  if (!TARGET_EXCEPTION_HANDLING)
+    return false;
+  gcc_assert (section == 0 && pending_eh_table.empty ());
+  /* final emits LSDA before assemble_end_function.  Buffer the genuine
+     data payload until the WAT function's closing delimiter has been output. */
+  char *table_bytes = nullptr;
+  size_t table_length = 0;
+  FILE *function_stream = asm_out_file;
+  asm_out_file = open_memstream (&table_bytes, &table_length);
+  std::vector<unsigned char> sites, body, header;
+  auto uleb = [] (std::vector<unsigned char> &out, unsigned value) {
+    do { unsigned byte = value & 127; value >>= 7;
+         out.push_back (byte | (value ? 128 : 0)); } while (value);
+  };
+  unsigned i;
+  call_site_record_d *site;
+  FOR_EACH_VEC_SAFE_ELT (crtl->eh.call_site_record_v[0], i, site)
+    {
+      uleb (sites, site->landing_pad ? i + 1 : 0);
+      uleb (sites, site->action);
+    }
+  body.push_back (1); /* DW_EH_PE_uleb128. */
+  uleb (body, sites.size ());
+  body.insert (body.end (), sites.begin (), sites.end ());
+  unsigned char byte;
+  FOR_EACH_VEC_SAFE_ELT (crtl->eh.action_record_data, i, byte)
+    body.push_back (byte);
+  unsigned types = vec_safe_length (cfun->eh->ttype_data);
+  header.push_back (255); /* Omitted LPStart: the runtime uses call-site ids. */
+  header.push_back (types ? 0 : 255); /* Absolute wasm32 RTTI pointers. */
+  if (types)
+    {
+      unsigned padding = 0, previous;
+      do
+        {
+          previous = padding;
+          header.resize (2);
+          uleb (header, body.size () + padding + 4 * types);
+          padding = (4 - ((header.size () + body.size ()) & 3)) & 3;
+        }
+      while (padding != previous);
+      body.insert (body.end (), padding, 0);
+    }
+  unsigned specs = vec_safe_length (cfun->eh->ehspec_data.other);
+  fprintf (asm_out_file,
+           "(data (@sym (align 4)) (i32.const 0)\n"
+           " (@sym $__gcc_wasm_lsda_%u local "
+           "(name \"__gcc_wasm_lsda_%u\") (size %zu))\n \"",
+           current_function_funcdef_no, current_function_funcdef_no,
+           header.size () + body.size () + 4 * types + specs);
+  for (auto value : header) fprintf (asm_out_file, "\\%02x", value);
+  for (auto value : body) fprintf (asm_out_file, "\\%02x", value);
+  fprintf (asm_out_file, "\"\n");
+  while (types--)
+    output_eh_type_entry ((*cfun->eh->ttype_data)[types]);
+  if (specs)
+    {
+      /* A null RTTI type entry is a WAT string without a trailing newline.
+         Keep the following exception-specification payload a separate token. */
+      fprintf (asm_out_file, "\n \"");
+      FOR_EACH_VEC_SAFE_ELT (cfun->eh->ehspec_data.other, i, byte)
+        fprintf (asm_out_file, "\\%02x", byte);
+      fprintf (asm_out_file, "\"\n");
+    }
+  fprintf (asm_out_file, ")\n");
+  fclose (asm_out_file);
+  asm_out_file = function_stream;
+  pending_eh_table.assign (table_bytes, table_length);
+  free (table_bytes);
+  return true;
+}
