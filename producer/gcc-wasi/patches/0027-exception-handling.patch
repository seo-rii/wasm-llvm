+;; Opaque exception references are VM locals, never integer registers.
+(define_c_enum "unspec" [UNSPEC_EH_RESUME])
+(define_c_enum "unspecv" [UNSPECV_EH_COPY])
+;; Resume must remain a CALL_INSN: late nothrow analysis must see that the
+;; original VM exception escapes, including when all ordinary calls are caught.
+(define_insn "wasm_eh_resume"
+  [(call (mem:SI (unspec:SI [(match_operand 0 "const_int_operand")]
+                          UNSPEC_EH_RESUME))
+         (const_int 0))
+   (use (reg:SI 6))]
+  "TARGET_EXCEPTION_HANDLING"
+  { return wasm_output_eh_resume (operands); })
+(define_insn "wasm_eh_copy"
+  [(unspec_volatile [(match_operand 0 "const_int_operand")
+                    (match_operand 1 "const_int_operand")] UNSPECV_EH_COPY)]
+  "TARGET_EXCEPTION_HANDLING"
+  { return wasm_output_eh_copy (operands); })
