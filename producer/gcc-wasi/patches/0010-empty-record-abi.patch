+/* The Basic C ABI ignores trivial empty records even when C++ gives the
+   object nonzero storage or explicit alignment.  Set TYPE_EMPTY_P during
+   layout so generic parameter/result expansion and Wasm signatures agree.
+   Ordinary nonzero-sized C++ members remain significant, including arrays
+   and unions of empty classes; only ABI-ignored bases/no_unique_address
+   fields, padding, unnamed bitfields and zero-sized fields are empty.  */
+#define TARGET_EMPTY_RECORD_P wasm_empty_record_p
+static bool
+wasm_empty_record_p (const_tree type)
+{
+  if (type == error_mark_node || !RECORD_OR_UNION_TYPE_P (type)
+      || TREE_ADDRESSABLE (type))
+    return false;
+  for (tree field = TYPE_FIELDS (type); field; field = DECL_CHAIN (field))
+    {
+      if (TREE_CODE (field) != FIELD_DECL || DECL_PADDING_P (field)
+          || DECL_FIELD_ABI_IGNORED (field))
+        continue;
+      if (DECL_BIT_FIELD (field) && !DECL_NAME (field))
+        continue;
+      if (!DECL_SIZE (field) || !integer_zerop (DECL_SIZE (field)))
+        return false;
+    }
+  return true;
+}
