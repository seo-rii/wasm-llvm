+std::string
+dwarf_name (const char *name)
+{
+  while (*name == '*')
+    ++name;
+  return name;
+}
+
+void
+restore_program_section (const char *)
+{
+  active_debug_section = nullptr;
+  if (program_asm_stream)
+    asm_out_file = program_asm_stream;
+}
+
+void
+record_debug_symbol (const std::string &name, const std::string &owner,
+		     const std::string &label, bool code)
+{
+  if (!dwarf_symbols.emplace (name, dwarf_symbol {owner, label, code}).second)
+    error ("duplicate WebAssembly debug label %qs", name.c_str ());
+}
+
+/* Generic DWARF uses label+constant strings for range/DIE offsets and
+   label-1 for views at a previous instruction.  Retain only that bounded
+   expression grammar; declared data symbol names are never parsed here.  */
+bool
+split_debug_reference (const char *input, std::string &label,
+		       HOST_WIDE_INT &offset)
+{
+  label = dwarf_name (input);
+  offset = 0;
+  size_t sign = label.find_first_of ("+-");
+  size_t base_length = sign == std::string::npos ? label.size () : sign;
+  bool valid = base_length != 0;
+  for (size_t i = 0; i < base_length; ++i)
+    if (!(ISALNUM (label[i]) || label[i] == '_' || label[i] == '.'
+	  || label[i] == '$'))
+      valid = false;
+  if (!valid)
+    {
+      error ("unsupported WebAssembly debug label expression %qs", input);
+      return false;
+    }
+  if (sign == std::string::npos)
+    return true;
+  if (!sign || sign + 1 == label.size ()
+      || label.find_first_of ("+-", sign + 1) != std::string::npos)
+    {
+      error ("unsupported WebAssembly debug label expression %qs", input);
+      return false;
+    }
+  const char *digits = label.c_str () + sign + 1;
+  bool negative = label[sign] == '-';
+  bool hex = digits[0] == '0' && (digits[1] == 'x' || digits[1] == 'X');
+  const char *begin = digits + (hex ? 2 : 0);
+  if (!*begin)
+    {
+      error ("unsupported WebAssembly debug label expression %qs", input);
+      return false;
+    }
+  for (const char *p = begin; *p; ++p)
+    if (!(hex ? ISXDIGIT (*p) : ISDIGIT (*p)))
+      {
+	error ("unsupported WebAssembly debug label expression %qs", input);
+	return false;
+      }
+  errno = 0;
+  char *end;
+  unsigned HOST_WIDE_INT magnitude = strtoull (digits, &end, hex ? 16 : 10);
+  unsigned HOST_WIDE_INT limit
+    = (unsigned HOST_WIDE_INT) HOST_WIDE_INT_MAX + (negative ? 1 : 0);
+  if (errno == ERANGE || *end || magnitude > limit)
+    {
+      error ("WebAssembly debug label addend overflows in %qs", input);
+      return false;
+    }
+  if (negative && magnitude == limit)
+    offset = HOST_WIDE_INT_MIN;
+  else
+    offset = negative ? -(HOST_WIDE_INT) magnitude : (HOST_WIDE_INT) magnitude;
+  label.resize (sign);
+  return true;
+}
+
+void
+record_debug_fixup (FILE *stream, dwarf_fixup::kind type, unsigned size,
+		    const char *high, const char *low, HOST_WIDE_INT addend)
+{
+  gcc_assert (active_debug_section && stream == active_debug_section->stream);
+  std::string high_label = dwarf_name (high), low_label;
+  if (type != dwarf_fixup::data_reference)
+    {
+      HOST_WIDE_INT high_offset, low_offset = 0;
+      if (!split_debug_reference (high, high_label, high_offset)
+	  || (low && !split_debug_reference (low, low_label, low_offset)))
+	return;
+      bool overflow;
+      HOST_WIDE_INT total = add_hwi (addend, high_offset, &overflow);
+      if (overflow || __builtin_sub_overflow (total, low_offset, &addend))
+	{
+	  error ("WebAssembly debug reference addend overflows");
+	  return;
+	}
+    }
+  unsigned index = dwarf_fixups.size ();
+  dwarf_fixups.push_back ({type, size, high_label, low_label, addend});
+  /* Raw control bytes cannot occur in target-escaped WAT literals. */
+  fprintf (stream, "\036%u\037", index);
+  if (size)
+    active_debug_section->size += size;
+}
+
+void
+write_debug_fixup (FILE *stream, const dwarf_fixup &fixup)
+{
+  if (fixup.type != dwarf_fixup::difference && fixup.size != 4)
+    {
+      error ("WebAssembly debug references require a four-byte address");
+      return;
+    }
+  if (fixup.type == dwarf_fixup::data_reference)
+    {
+      fprintf (stream, " (@ref i32 data $%s %+" HOST_WIDE_INT_PRINT "d)",
+	       fixup.high.c_str (), fixup.addend);
+      return;
+    }
+  auto high = dwarf_symbols.find (fixup.high);
+  if (high == dwarf_symbols.end ())
+    {
+      error ("unresolved WebAssembly debug label %qs", fixup.high.c_str ());
+      return;
+    }
+  const dwarf_symbol &symbol = high->second;
+  if (fixup.type == dwarf_fixup::difference)
+    {
+      auto low = dwarf_symbols.find (fixup.low);
+      if (low == dwarf_symbols.end () || low->second.code != symbol.code
+	  || low->second.owner != symbol.owner)
+	{
+	  error ("WebAssembly debug difference crosses label owners: %qs and %qs",
+		 fixup.high.c_str (), fixup.low.c_str ());
+	  return;
+	}
+      if (fixup.size)
+	fprintf (stream, " (@delta i%u $%s $%s", fixup.size * 8,
+		 symbol.label.c_str (), low->second.label.c_str ());
+      else
+	fprintf (stream, " (@delta uleb $%s $%s", symbol.label.c_str (),
+		 low->second.label.c_str ());
+      if (fixup.addend)
+	fprintf (stream, " %+" HOST_WIDE_INT_PRINT "d", fixup.addend);
+      fputc (')', stream);
+      return;
+    }
+  fprintf (stream, " (@ref i32 %s $%s $%s %+" HOST_WIDE_INT_PRINT "d)",
+	   symbol.code ? "text" : "custom", symbol.owner.c_str (),
+	   symbol.label.c_str (), fixup.addend);
+}
+
+void
+write_debug_section (FILE *stream, dwarf_section_buffer *section)
+{
+  fflush (section->stream);
+  fprintf (stream, "  (@custom $%s \"%s\"\n", section->id.c_str (),
+	   section->name.c_str ());
+  const char *cursor = section->bytes;
+  const char *end = cursor + section->length;
+  while (cursor != end)
+    {
+      if (*cursor != '\036')
+	{
+	  fputc (*cursor++, stream);
+	  continue;
+	}
+      char *next;
+      unsigned long index = strtoul (cursor + 1, &next, 10);
+      gcc_assert (next != cursor + 1 && next < end && *next == '\037'
+		  && index < dwarf_fixups.size ());
+      write_debug_fixup (stream, dwarf_fixups[index]);
+      cursor = next + 1;
+    }
+  fputs ("\n  )\n", stream);
+}
+
+void
+record_local_declaration (rtx reg, unsigned offset, unsigned size)
+{
+  if (!emitting_dwarf_function)
+    return;
+  dwarf_function &function = *emitting_dwarf_function;
+  gcc_assert (!function.sealed);
+  function.registers[REGNO (reg)].push_back
+    ({function.next_index++, offset, size});
+}
