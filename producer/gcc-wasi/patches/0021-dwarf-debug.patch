+/* Only GCC's DWARF emitter creates these fragments.  A reference is retained
+   as a typed fixup until all forward-defined debug labels are known. */
+struct dwarf_section_buffer
+{
+  std::string name, id;
+  char *bytes = nullptr;
+  size_t length = 0, size = 0;
+  FILE *stream = nullptr;
+};
+struct dwarf_symbol
+{
+  std::string owner, label;
+  bool code;
+};
+struct dwarf_fixup
+{
+  enum kind { reference, difference, data_reference } type;
+  unsigned size;
+  std::string high, low;
+  HOST_WIDE_INT addend;
+};
+struct dwarf_function
+{
+  std::string name, begin, ready;
+  std::vector<std::string> ends;
+  std::map<unsigned, std::vector<wasm_dwarf_piece>> registers;
+  unsigned next_index = 0;
+  bool sealed = false;
+  bool has_frame = false;
+};
+FILE *program_asm_stream;
+dwarf_section_buffer *active_debug_section;
+std::vector<dwarf_section_buffer *> dwarf_sections;
+std::map<std::string, dwarf_symbol> dwarf_symbols;
+std::vector<dwarf_fixup> dwarf_fixups;
+std::map<unsigned, dwarf_function> dwarf_functions;
+dwarf_function *emitting_dwarf_function;
