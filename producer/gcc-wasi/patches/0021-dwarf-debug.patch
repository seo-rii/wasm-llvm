+bool
+wasm_dwarf_enabled_p ()
+{
+  return debug_info_level != DINFO_LEVEL_NONE && write_symbols == DWARF2_DEBUG;
+}
+
+void
+wasm_dwarf_named_section (const char *name, unsigned flags, tree)
+{
+  if (!wasm_dwarf_enabled_p () || strncmp (name, ".debug_", 7))
+    {
+      /* Code and data retain the existing Wasm entity serializer; only
+	 debug payloads need a separate logical output stream.  */
+      (void) flags;
+      restore_program_section (nullptr);
+      return;
+    }
+  for (auto section : dwarf_sections)
+    if (section->name == name)
+      {
+	active_debug_section = section;
+	asm_out_file = section->stream;
+	return;
+      }
+  dwarf_section_buffer *section = new dwarf_section_buffer;
+  section->name = name;
+  section->id = "__gcc_debug_section_" + std::to_string (dwarf_sections.size ());
+  section->stream = open_memstream (&section->bytes, &section->length);
+  gcc_assert (section->stream);
+  dwarf_sections.push_back (section);
+  active_debug_section = section;
+  asm_out_file = section->stream;
+}
+
+section *
+wasm_dwarf_function_section (tree decl, enum node_frequency, bool, bool)
+{
+  if (!wasm_dwarf_enabled_p ())
+    return nullptr;
+  std::string name = ".text.";
+  name += IDENTIFIER_POINTER (DECL_ASSEMBLER_NAME (decl));
+  return get_named_section (decl, name.c_str (), 0);
+}
+
+void
+wasm_dwarf_output_label (FILE *stream, const char *name)
+{
+  if (!wasm_dwarf_enabled_p ())
+    return;
+  std::string label = dwarf_name (name);
+  if (active_debug_section)
+    {
+      record_debug_symbol (label, active_debug_section->id, label, false);
+      fprintf (stream, " (@label $%s)\n", label.c_str ());
+    }
+  else if (emitting_dwarf_function)
+    {
+      if (label.compare (0, 3, "LFB") == 0)
+	record_debug_symbol (label, emitting_dwarf_function->name,
+			     emitting_dwarf_function->begin, true);
+      else if (label.compare (0, 3, "LFE") == 0)
+	{
+	  record_debug_symbol (label, emitting_dwarf_function->name, label, true);
+	  emitting_dwarf_function->ends.push_back (label);
+	}
+      else
+	{
+	  record_debug_symbol (label, emitting_dwarf_function->name, label, true);
+	  fprintf (stream, "(@code.label $%s)\n", label.c_str ());
+	}
+    }
+  /* Unreferenced generic file-level text labels have no Wasm PC.  A real
+     reference to one is rejected when typed fixups are resolved at file-end. */
+}
+
+void
+wasm_dwarf_output_delta (FILE *stream, unsigned size, const char *high,
+			 const char *low)
+{
+  record_debug_fixup (stream, dwarf_fixup::difference, size, high, low, 0);
+}
+
+void
+wasm_dwarf_output_delta_uleb (FILE *stream, const char *high, const char *low)
+{
+  record_debug_fixup (stream, dwarf_fixup::difference, 0, high, low, 0);
+}
+
+void
+wasm_dwarf_output_offset (FILE *stream, unsigned size, const char *label,
+			  HOST_WIDE_INT offset)
+{
+  record_debug_fixup (stream, dwarf_fixup::reference, size, label, nullptr,
+		      offset);
+}
+
+void
+wasm_dwarf_end_prologue ()
+{
+  if (!emitting_dwarf_function || !wasm_dwarf_enabled_p ())
+    return;
+  dwarf_function &function = *emitting_dwarf_function;
+  if (!function.ready.empty ())
+    return;
+  function.ready = "__gcc_wasm_frame_ready_"
+		   + std::to_string (DECL_UID (current_function_decl));
+  record_debug_symbol (function.ready, function.name, function.ready, true);
+  fprintf (asm_out_file, "(@code.label $%s)\n", function.ready.c_str ());
+}
+
+unsigned
+wasm_dwarf_register_pieces (rtx value, wasm_dwarf_piece *pieces,
+			    unsigned capacity)
+{
+  if (optimize || !current_function_decl)
+    return 0;
+  auto function = dwarf_functions.find (DECL_UID (current_function_decl));
+  if (function == dwarf_functions.end () || !function->second.sealed)
+    return 0;
+  unsigned offset = 0;
+  unsigned requested = GET_MODE_SIZE (GET_MODE (value));
+  if (SUBREG_P (value))
+    {
+      offset = SUBREG_BYTE (value).to_constant ();
+      value = SUBREG_REG (value);
+    }
+  if (!REG_P (value))
+    return 0;
+  auto location = function->second.registers.find (REGNO (value));
+  if (location == function->second.registers.end ())
+    return 0;
+  unsigned count = 0;
+  for (auto piece : location->second)
+    if (piece.offset >= offset && piece.offset + piece.size <= offset + requested
+	&& count < capacity)
+      {
+	piece.offset -= offset;
+	pieces[count++] = piece;
+      }
+  return count;
+}
+
+bool
+wasm_dwarf_finalized_locations_p ()
+{
+  if (!wasm_dwarf_enabled_p () || optimize || !current_function_decl)
+    return false;
+  auto function = dwarf_functions.find (DECL_UID (current_function_decl));
+  return function != dwarf_functions.end () && function->second.sealed;
+}
+
+/* Restore only an unused scalar parameter whose actual ABI local still
+   contains its incoming value throughout the function.  Merely finding an
+   unwritten incoming local is insufficient: dead stores to a reassigned
+   source parameter can also disappear at -O0.  TREE_USED distinguishes that
+   case in the C and C++ frontends, including assignments without any reads. */
+rtx
+wasm_dwarf_parameter_location (tree decl, rtx current)
+{
+  if (!wasm_dwarf_finalized_locations_p ()
+      || TREE_CODE (decl) != PARM_DECL
+      || TREE_USED (decl) || TREE_ADDRESSABLE (decl) || DECL_BY_REFERENCE (decl)
+      || !cfun || cfun->decl != current_function_decl)
+    return current;
+
+  wasm_dwarf_piece pieces[2];
+  if (current
+      && ((!REG_P (current) && !SUBREG_P (current))
+	  || wasm_dwarf_register_pieces (current, pieces, 2)))
+    return current;
+
+  tree passed_type = DECL_ARG_TYPE (decl);
+  machine_mode mode = TYPE_MODE (TREE_TYPE (decl));
+  rtx incoming = DECL_INCOMING_RTL (decl);
+  if (!passed_type || mode != TYPE_MODE (passed_type)
+      || (!SCALAR_INT_MODE_P (mode) && !SCALAR_FLOAT_MODE_P (mode))
+      || !incoming || !REG_P (incoming) || GET_MODE (incoming) != mode
+      || REGNO (incoming) < FIRST_PSEUDO_REGISTER
+      || wasm_dwarf_register_pieces (incoming, pieces, 2) != 1
+      || pieces[0].offset != 0 || pieces[0].size != GET_MODE_SIZE (mode))
+    return current;
+
+  /* DECL_INCOMING_RTL must identify a real parameter, rather than a return,
+     argument-buffer, frame, or outgoing-call temporary local.  Compare regnos
+     since generic parameter setup may have copied or annotated the RTL. */
+  bool parameter = false;
+  unsigned i;
+  rtx arg;
+  FOR_EACH_VEC_SAFE_ELT (cfun->machine->func_args, i, arg)
+    if (REG_P (arg) && REGNO (arg) == REGNO (incoming)
+	&& GET_MODE (arg) == mode)
+      {
+	parameter = true;
+	break;
+      }
+  if (!parameter)
+    return current;
+
+  /* A single location is valid for the whole body only if no instruction
+     sets or clobbers the incoming local, including partial writes and call
+     function-usage clobbers.  Do not infer safety from ordinary liveness. */
+  for (rtx_insn *insn = get_insns (); insn; insn = NEXT_INSN (insn))
+    if (NONDEBUG_INSN_P (insn) && reg_set_p (incoming, insn))
+      return current;
+  return incoming;
+}
+
+bool
+wasm_dwarf_frame_index (unsigned *index)
+{
+  wasm_dwarf_piece piece[2];
+  auto function = dwarf_functions.find (DECL_UID (current_function_decl));
+  if (function != dwarf_functions.end () && function->second.has_frame
+      && wasm_dwarf_register_pieces (frame_pointer_rtx, piece, 2) == 1)
+    {
+      *index = piece[0].index;
+      return true;
+    }
+  if (wasm_dwarf_register_pieces (regno_reg_rtx[WASM_BASE_POINTER_REGNUM],
+				  piece, 2) == 1)
+    {
+      *index = piece[0].index;
+      return true;
+    }
+  return false;
+}
+
+const char *
+wasm_dwarf_frame_ready_label ()
+{
+  if (!current_function_decl)
+    return nullptr;
+  auto function = dwarf_functions.find (DECL_UID (current_function_decl));
+  return function != dwarf_functions.end () && !function->second.ready.empty ()
+	 ? function->second.ready.c_str () : nullptr;
+}
