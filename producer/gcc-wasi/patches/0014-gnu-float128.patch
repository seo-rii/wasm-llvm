diff --git a/gcc/config/wasm/wasm.cc b/gcc/config/wasm/wasm.cc
--- a/gcc/config/wasm/wasm.cc
+++ b/gcc/config/wasm/wasm.cc
@@ -26,6 +26,7 @@
 #include "rtl.h"
 #include "tree.h"
 #include "langhooks.h"
+#include "stor-layout.h"
 #include "tm_p.h"
 #include "stringpool.h"
 #include "attribs.h"
@@ -87,6 +88,21 @@
 static void
 wasm_init_builtins (void)
 {
+  /* C uses the existing _Float128 type.  C++ requires a distinct GNU type
+     for overload resolution and the Itanium ABI's g mangling.  Both reuse
+     the already qualified TFmode representation and runtime helpers.  */
+  gcc_assert (float128_type_node
+              && TYPE_MODE (float128_type_node) == TFmode);
+  if (float128t_type_node == NULL_TREE)
+    {
+      float128t_type_node = make_node (REAL_TYPE);
+      TYPE_PRECISION (float128t_type_node)
+        = TYPE_PRECISION (float128_type_node);
+      SET_TYPE_MODE (float128t_type_node, TFmode);
+      layout_type (float128t_type_node);
+    }
+  lang_hooks.types.register_builtin_type (float128t_type_node, "__float128");
+
   for (unsigned i = 0; i < WASM_BUILTIN_MAX; ++i)
     {
       const wasm_builtin_description &d = wasm_builtins[i];
@@ -103,6 +119,25 @@
     }
 }
 #define TARGET_INIT_BUILTINS wasm_init_builtins
+
+/* GNU Q/q literals retain binary128 precision without enabling SIMD.  */
+static machine_mode
+wasm_c_mode_for_suffix (char suffix)
+{
+  return suffix == 'q' ? TFmode : VOIDmode;
+}
+#define TARGET_C_MODE_FOR_SUFFIX wasm_c_mode_for_suffix
+
+static const char *
+wasm_mangle_type (const_tree type)
+{
+  if (float128t_type_node
+      && TYPE_MAIN_VARIANT (type) == float128t_type_node)
+    return "g";
+  /* In particular, long double remains e and _Float128 remains DF128_.  */
+  return NULL;
+}
+#define TARGET_MANGLE_TYPE wasm_mangle_type
 
 static tree
 wasm_builtin_decl (unsigned code, bool ARG_UNUSED (initialize_p))
