diff --git a/libstdc++-v3/libsupc++/eh_wasm.cc b/libstdc++-v3/libsupc++/eh_wasm.cc
new file mode 100644
index 000000000..1cc0cfae8
--- /dev/null
+++ b/libstdc++-v3/libsupc++/eh_wasm.cc
@@ -0,0 +1,44 @@
+// Native WebAssembly exception termination boundaries for WASI commands.
+// This file is part of GCC.
+// SPDX-License-Identifier: GPL-3.0-or-later WITH GCC-exception-3.1
+
+#if defined(__wasm32__) && defined(__WASM_EXCEPTIONS__)
+#include <exception>
+
+// WASI's C entry and exit code cannot perform a C++ exception search.  Keep
+// these boundaries in genuine C++ so an escaping C++ exception invokes the
+// GNU terminate handler.  The exception profile links with the four matching
+// --wrap options; other profiles do not acquire these functions.
+extern "C" int __real___main_void ();
+extern "C" void __real___wasm_call_ctors ();
+extern "C" void __real___wasm_call_dtors ();
+extern "C" void __real_exit (int) __attribute__((__noreturn__));
+
+extern "C" int
+__wrap___main_void ()
+{
+  try { return __real___main_void (); }
+  catch (...) { std::terminate (); }
+}
+
+extern "C" void
+__wrap___wasm_call_ctors ()
+{
+  try { __real___wasm_call_ctors (); }
+  catch (...) { std::terminate (); }
+}
+
+extern "C" void
+__wrap___wasm_call_dtors ()
+{
+  try { __real___wasm_call_dtors (); }
+  catch (...) { std::terminate (); }
+}
+
+extern "C" void
+__wrap_exit (int code)
+{
+  try { __real_exit (code); }
+  catch (...) { std::terminate (); }
+}
+#endif
