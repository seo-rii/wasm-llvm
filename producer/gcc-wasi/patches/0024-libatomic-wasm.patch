+   WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS
+   FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+   more details.
+
+   Under Section 7 of GPL version 3, you are granted additional
+   permissions described in the GCC Runtime Library Exception, version
+   3.1, as published by the Free Software Foundation.
+
+   You should have received a copy of the GNU General Public License and
+   a copy of the GCC Runtime Library Exception along with this program;
+   see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
+   <http://www.gnu.org/licenses/>.  */
+
+#include "libatomic_i.h"
+
+/* One table in the linked module's linear-memory BSS, shared by all
+   instances importing that memory.  The embedding initializes data/BSS
+   exactly once before any worker enters the module; no worker-local
+   initializer may reset these words while another worker uses them.  */
+#define WATCH_SIZE 64
+#define NLOCKS 64
+
+struct lock
+{
+  U_4 value;
+  unsigned char padding[WATCH_SIZE - sizeof (U_4)];
+} __attribute__((aligned(WATCH_SIZE)));
+
+static struct lock locks[NLOCKS];
+_Static_assert (sizeof (U_4) == 4, "Wasm lock words must be 32 bits");
+_Static_assert (__atomic_always_lock_free (4, 0),
+                "Wasm lock primitives must not call libatomic recursively");
+
+/* Return a bounded number of consecutive hashed watch regions.  Clamp
+   before adding the partial first region, so a huge n cannot overflow.  */
+static inline size_t
+range_count (uintptr_t address, size_t n)
+{
+  if (n == 0)
+    return 0;
+  if (n >= NLOCKS * WATCH_SIZE)
+    return NLOCKS;
+  size_t count = (n + (address % WATCH_SIZE) + WATCH_SIZE - 1) / WATCH_SIZE;
+  return count < NLOCKS ? count : NLOCKS;
+}
+
+static inline bool
+covers_slot (size_t first, size_t count, size_t slot)
+{
+  return (slot + NLOCKS - first) % NLOCKS < count;
+}
+
+static inline void
+lock_slot (size_t slot)
+{
+  U_4 expected;
+  do
+    {
+      while (__atomic_load_n (&locks[slot].value, __ATOMIC_SEQ_CST) != 0)
+        ;
+      expected = 0;
+    }
+  while (!__atomic_compare_exchange_n (&locks[slot].value, &expected, 1,
+                                       false, __ATOMIC_SEQ_CST,
+                                       __ATOMIC_SEQ_CST));
+}
+
+void
+libat_lock_n (void *ptr, size_t n)
+{
+  uintptr_t address = (uintptr_t) ptr;
+  size_t first = (address / WATCH_SIZE) % NLOCKS;
+  size_t count = range_count (address, n);
+
+  /* A total order on unique slots avoids self-locking and ABBA deadlock,
+     including ranges whose hash wraps from the last slot back to zero.  */
+  for (size_t slot = 0; slot < NLOCKS; ++slot)
+    if (covers_slot (first, count, slot))
+      lock_slot (slot);
+}
+
+void
+libat_unlock_n (void *ptr, size_t n)
+{
+  uintptr_t address = (uintptr_t) ptr;
+  size_t first = (address / WATCH_SIZE) % NLOCKS;
+  size_t count = range_count (address, n);
+  for (size_t slot = NLOCKS; slot-- > 0; )
+    if (covers_slot (first, count, slot))
+      __atomic_store_n (&locks[slot].value, 0, __ATOMIC_SEQ_CST);
+}
diff --git a/libatomic/config/wasm/glfree.c b/libatomic/config/wasm/glfree.c
