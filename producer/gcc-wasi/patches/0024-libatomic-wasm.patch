+   permissions described in the GCC Runtime Library Exception, version
+   3.1, as published by the Free Software Foundation.
+
+   You should have received a copy of the GNU General Public License and
+   a copy of the GCC Runtime Library Exception along with this program;
+   see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
+   <http://www.gnu.org/licenses/>.  */
+
+#define LAT_GLFREE
+#include "libatomic_i.h"
+
+/* Conservative public policy: naturally aligned native widths only.
+   Generic fallback may use a larger native CAS for some other sizes, but
+   that optimization does not broaden the advertised lock-free contract.
+   In particular, no 16-byte operation is advertised as lock-free.  */
+bool
+libat_is_lock_free (size_t n, void *ptr)
+{
+  switch (n)
+    {
+    case 0: return true;
+    case 1: return __atomic_always_lock_free (1, 0);
+    case 2: return !((uintptr_t) ptr & 1) && __atomic_always_lock_free (2, 0);
+    case 4: return !((uintptr_t) ptr & 3) && __atomic_always_lock_free (4, 0);
+    case 8: return !((uintptr_t) ptr & 7) && __atomic_always_lock_free (8, 0);
+    default: return false;
+    }
+}
+
+EXPORT_ALIAS (is_lock_free);
+#undef LAT_GLFREE
