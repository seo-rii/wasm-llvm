+   see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
+   <http://www.gnu.org/licenses/>.  */
+
+/* Native Wasm atomics implement every accepted order as sequentially
+   consistent.  The shared lock words therefore need no pthread runtime.  */
+#if !defined(__wasm_atomics__) || !defined(__GCC_HAVE_SYNC_COMPARE_AND_SWAP_4)
+# error "Wasm libatomic requires native 32-bit atomics (-matomics)"
+#endif
+
+/* Every locked sized operation uses the same complete range protocol as
+   generic operations.  This also keeps the 16-byte helper and generic
+   16-byte entry points coherent without nesting locks.  */
+#ifdef N
+static inline UWORD
+protect_start (void *ptr)
+{
+  libat_lock_n (ptr, N);
+  return 0;
+}
+
+static inline void
+protect_end (void *ptr, UWORD magic UNUSED)
+{
+  libat_unlock_n (ptr, N);
+}
+#define protect_start_end 1
+#endif
+
+static inline void __attribute__((always_inline, artificial))
+pre_seq_barrier (int model UNUSED)
+{
+  __atomic_thread_fence (__ATOMIC_SEQ_CST);
+}
+
+static inline void __attribute__((always_inline, artificial))
+post_seq_barrier (int model UNUSED)
+{
+  __atomic_thread_fence (__ATOMIC_SEQ_CST);
+}
+#define pre_post_seq_barrier 1
+
+#include_next <host-config.h>
diff --git a/libatomic/config/wasm/lock.c b/libatomic/config/wasm/lock.c
new file mode 100644
--- /dev/null
+++ b/libatomic/config/wasm/lock.c
@@ -0,0 +1,102 @@
+/* Copyright (C) 2012-2026 Free Software Foundation, Inc.
+   Contributed by Richard Henderson <rth@redhat.com>.
+
+   This file is part of the GNU Atomic Library (libatomic).
+
+   Libatomic is free software; you can redistribute it and/or modify it
