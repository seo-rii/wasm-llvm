+/* Relaxed operations have an explicit target builtin and UNSPEC pattern.
+   Do not give them ordinary arithmetic optabs: scalar or baseline SIMD code,
+   including -ffast-math, must never acquire relaxed instructions implicitly.
+   The names and exact vector types match LLVM 22.1.0's WebAssembly builtins.  */
+struct wasm_relaxed_builtin_description
+{
+  const char *name;
+  machine_mode result_mode;
+  machine_mode operand_modes[3];
+  unsigned arity;
+  bool unsigned_result;
+  insn_code instruction;
+};
+static const wasm_relaxed_builtin_description wasm_relaxed_builtins[] =
+{
+  { "__builtin_wasm_relaxed_swizzle_i8x16",
+    V16QImode, { V16QImode, V16QImode, VOIDmode },
+    2, false, CODE_FOR_wasm_relaxed_swizzle_i8x16 },
