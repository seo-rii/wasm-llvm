+/* A v128 result occupies one Wasm local.  Counting it as two hard regs
+   would overlap $return (reg 0) with the unrelated $stack (reg 1) in DF.  */
+#define TARGET_HARD_REGNO_NREGS \
+  [] (unsigned int regno, machine_mode mode) \
+    { return wasm_vector_mode_supported_p (mode) \
+        ? 1 : default_hard_regno_nregs (regno, mode); }
+
+/* A v128 local is not an integer pair.  In particular, lower-subreg must
+   not split a vector copy through TImode and invent unsupported subregs.  */
+#define TARGET_MODES_TIEABLE_P wasm_modes_tieable_p
+static bool
+wasm_modes_tieable_p (machine_mode from, machine_mode to)
+{
+  if (TARGET_SIMD128 && (VECTOR_MODE_P (from) || VECTOR_MODE_P (to)))
+    return wasm_vector_mode_supported_p (from)
+      && wasm_vector_mode_supported_p (to);
+  return true;
+}
+
+/* Keep vector-containing aggregates in memory internally, instead of
+   constructing integer container registers for their ABI parallel values.
+   The call hooks still pass singleton vectors directly as v128.  */
+#define TARGET_MEMBER_TYPE_FORCES_BLK wasm_member_type_forces_blk
+static bool
+wasm_member_type_forces_blk (const_tree field, machine_mode)
+{
+  const_tree type = TREE_CODE (field) == FIELD_DECL ? TREE_TYPE (field) : field;
+  while (TREE_CODE (type) == ARRAY_TYPE)
+    type = TREE_TYPE (type);
+  return TREE_CODE (type) == VECTOR_TYPE
+    && wasm_vector_mode_supported_p (TYPE_MODE (type));
+}
