+#!/usr/bin/env python3
+"""Native black-box checks for owning DWARF slots and checked code layout.
+
+Requires the pinned native LLVM tools. This validates assembler transport;
+genuine GCC source/type/local-value qualification remains a separate gate.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+import subprocess
+import time
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('--bindir', required=True, type=Path)
+parser.add_argument('--llvm-bindir', required=True, type=Path)
+parser.add_argument('--output', required=True, type=Path)
+parser.add_argument('--baseline-bindir', type=Path)
+args = parser.parse_args()
+args.output.mkdir(parents=True, exist_ok=False)
+commands, cases = [], []
+started = time.time()
+
+
+def identity(file):
+    data = file.read_bytes()
+    return {'path': str(file.resolve()), 'bytes': len(data),
+            'sha256': hashlib.sha256(data).hexdigest()}
+
+
+def run(argv, expected=0):
+    result = subprocess.run(list(map(str, argv)), capture_output=True, text=True, timeout=120)
+    commands.append({'argv': list(map(str, argv)), 'exitCode': result.returncode,
+                     'stdout': result.stdout, 'stderr': result.stderr})
+    assert (result.returncode == 0) if expected == 0 else (result.returncode > 0), commands[-1]
+    return result
+
+
+def assemble(name, source, good=True, extra=()):
+    wat = args.output / (name + '.wat')
+    binary = args.output / (name + '.o')
+    wat.write_text(source)
+    result = run([args.bindir / 'wat2wasm', '--enable-annotations', '-r', *extra,
+                  wat, '-o', binary], 0 if good else 1)
+    if good:
+        run([args.bindir / 'wasm-validate', *[x for x in extra if x.startswith('--enable-')], binary])
+    else:
+        assert not binary.exists(), 'Rejected input left a binary'
+    cases.append({'id': name, 'status': 'passed', 'accepted': good,
+                  'source': identity(wat), **({'binary': identity(binary)} if good else {})})
+    return binary, result
+
+
+def uleb(data, offset):
+    value, shift = 0, 0
+    while True:
+        byte = data[offset]
+        offset += 1
+        value |= (byte & 127) << shift
+        if byte < 128:
+            return value, offset
+        shift += 7
+        assert shift <= 35
+
+
+def sections(file):
+    data = file.read_bytes()
+    assert data[:8] == b'\0asm\1\0\0\0'
+    result, cursor = [], 8
+    while cursor < len(data):
+        kind = data[cursor]
+        size, start = uleb(data, cursor + 1)
+        end = start + size
+        name = None
+        if kind == 0:
+            length, start = uleb(data, start)
+            name = data[start:start + length].decode()
+            start += length
+        result.append({'kind': kind, 'name': name, 'data': data[start:end]})
+        cursor = end
+    return result
+
+
+def custom(file, name):
+    return next(s['data'] for s in sections(file) if s['name'] == name)
+
+
+def relocations(file, name):
+    data = custom(file, 'reloc.' + name)
+    section, cursor = uleb(data, 0)
+    count, cursor = uleb(data, cursor)
+    result = []
+    for _ in range(count):
+        kind, cursor = uleb(data, cursor)
+        offset, cursor = uleb(data, cursor)
+        symbol, cursor = uleb(data, cursor)
+        addend = 0
+        if kind in (5, 8, 9):
+            begin = cursor
+            unsigned, cursor = uleb(data, cursor)
+            width = 7 * (cursor - begin)
+            addend = unsigned - (1 << width) if data[cursor - 1] & 64 else unsigned
+        result.append((kind, offset, symbol, addend))
+    assert cursor == len(data)
+    actual = sections(file)[section]
+    assert actual['name'] == name, 'Physical relocation target differs'
+    return result
+
+
+def roundtrip(name, binary, extra=()):
+    wat = args.output / (name + '-readback.wat')
+    run([args.bindir / 'wasm2wat', '--enable-annotations', '-r', binary, '-o', wat])
+    text = wat.read_text()
+    assert '(@code.layout' in text
+    rebuilt, _ = assemble(name + '-roundtrip', text, extra=extra)
+    for section in sections(binary):
+        if section['name'] and section['name'].startswith('.debug_'):
+            assert custom(rebuilt, section['name']) == section['data']
+            old = relocations(binary, section['name']) if any(
