+    rebuilt = args.output / 'function-alias-ref-roundtrip.o'
+    new_refs = relocations(rebuilt, '.debug_alias')
+    assert new_refs[0][2] != new_refs[1][2]
+
+    for used in [False, True]:
+        instructions = 'i32.const 0 i32.const 0 i32.const 1 memory.init 0 data.drop 0' if used else 'nop'
+        source = '(module (memory 1) (data "X") (@custom "unrelated" "raw") '
+        source += '(func $f (@metadata.code.marker "X") (@code.label $b) ' + instructions
+        source += ' (@code.label $e (after end))) '
+        source += '(@custom $long "' + '.debug_' + 'x' * 130 + '" (@label $l) "Z") '
+        source += '(@custom $s ".debug_ordinals" (@ref i32 custom $long $l) (@ref i32 text $f $b)))'
+        obj, _ = assemble('section-ordinals-' + str(used), source, extra=['--enable-code-metadata'])
+        assert len(custom(obj, '.debug_ordinals')) == 8
+        assert [(t, o) for t, o, _, _ in relocations(obj, '.debug_ordinals')] == [(9, 0), (8, 4)]
+        assert any(s['kind'] == 12 for s in sections(obj)) == used
+        readback = args.output / ('ordinals-' + str(used) + '-readback.wat')
+        run([args.bindir / 'wasm2wat', '--enable-annotations', '--enable-code-metadata', '-r', obj, '-o', readback])
+        rebuilt, _ = assemble('ordinals-' + str(used) + '-roundtrip', readback.read_text(), extra=['--enable-code-metadata'])
+        assert custom(obj, '.debug_ordinals') == custom(rebuilt, '.debug_ordinals')
+
+    long_name = '.debug_' + 'r' * 140
+    obj, _ = assemble('long-reloc-section-name', '(module ' + simple + ' (@custom $s "' + long_name + '" (@ref i32 text $f $b)))')
+    assert [(t, o) for t, o, _, _ in relocations(obj, long_name)] == [(8, 0)]
+    roundtrip('long-reloc-section-name', obj)
+
+    obj, _ = assemble('same-named-customs', '(module (@custom $a ".debug_same" (@label $a0) "A") '
+        '(@custom $b ".debug_same" (@label $b0) "B") '
+        '(@custom $r ".debug_refs" (@ref i32 custom $a $a0) (@ref i32 custom $b $b0)))')
+    same = [x for x in sections(obj) if x['name'] == '.debug_same']
+    assert [x['data'] for x in same] == [b'A', b'B']
+    refs = relocations(obj, '.debug_refs')
+    assert refs[0][2] != refs[1][2]
+    readback = args.output / 'same-named-readback.wat'
+    run([args.bindir / 'wasm2wat', '--enable-annotations', '-r', obj, '-o', readback])
+    rebuilt, _ = assemble('same-named-roundtrip', readback.read_text())
+    assert [x['data'] for x in sections(rebuilt) if x['name'] == '.debug_same'] == [b'A', b'B']
+
+    if args.baseline_bindir:
+        for name, source in {
+            'integer': '(module (func (export "f") (param i32) (result i32) local.get 0 i32.const 7 i32.add))',
+            'simd': '(module (func i32.const 7 i8x16.splat drop v128.const i32x4 0 1 2 3 drop))',
+            'memory': '(module (memory 1) (data (i32.const 4) "abc") (func (result i32) i32.const 4 i32.load8_u))',
+            'nested': '(module (func (param i32) (result i32) local.get 0 (if (result i32) (then i32.const 63) (else i32.const 64))))',
+            'long-body': '(module (func ' + 'nop ' * 128 + '))',
+        }.items():
+            candidate, _ = assemble('release-' + name, source)
+            old = args.output / ('baseline-' + name + '.o')
+            run([args.baseline_bindir / 'wat2wasm', '--enable-annotations', '-r', args.output / ('release-' + name + '.wat'), '-o', old])
+            assert candidate.read_bytes() == old.read_bytes(), name
+
+    fixture = Path(__file__).with_suffix('.wat').read_text()
+    obj, _ = assemble('real-dwarf4-slots', fixture)
+    run([args.llvm_bindir / 'llvm-dwarfdump', '--verify', obj])
+    rebuilt_text = roundtrip('real-dwarf4-slots', obj)
+    linked = args.output / 'real-dwarf4-slots.wasm'
+    run([args.llvm_bindir / 'wasm-ld', '--no-entry', '--export=probe', obj, '-o', linked])
+    run([args.llvm_bindir / 'llvm-dwarfdump', '--verify', linked])
+    roundtrip('linked-dwarf4-slots', linked)
+    for flag in ['--strip-debug', '--strip-all']:
+        stripped = args.output / (flag[2:] + '.wasm')
+        run([args.llvm_bindir / 'wasm-ld', '--no-entry', '--export=probe', flag, obj, '-o', stripped])
+        assert not any(s['name'] and s['name'].startswith('.debug_') for s in sections(stripped))
+    run([args.llvm_bindir / 'wasm-ld', '--no-entry', '--compress-relocations', obj,
+         '-o', args.output / 'must-not-compress.wasm'], 1)
+    status = 'passed'
+except Exception as exception:
+    error = str(exception)
+    raise
+finally:
+    report = {'kind': 'wabt-native-dwarf-transport-tests', 'status': status, 'error': error,
+              'elapsedSeconds': time.time() - started, 'cases': cases, 'commands': commands,
+              'scope': 'Assembler transport and real LLVM object/link validation; not genuine GCC debug qualification'}
+    (args.output / 'qualification.json').write_text(json.dumps(report, indent=2) + '\n')
+    print(json.dumps({'status': status, 'cases': len(cases), 'commands': len(commands), 'output': str(args.output)}))
