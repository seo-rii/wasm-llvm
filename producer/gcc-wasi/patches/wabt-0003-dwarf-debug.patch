+
+Result WastParser::ParseDebugAddend(int64_t* result) {
+  *result = 0;
+  if (PeekMatch(TokenType::Rpar)) return Result::Ok;
+  if (!PeekMatch(TokenType::Int)) return ErrorExpected({"signed integer addend"});
+  Token token = Consume();
+  auto text = token.literal().text;
+  if (text.empty() || (text.front() != '+' && text.front() != '-'))
+    return ErrorExpected({"explicit signed integer addend"});
+  uint64_t magnitude;
+  if (Failed(ParseUint64(text.substr(1), &magnitude)) ||
+      magnitude > uint64_t(std::numeric_limits<int64_t>::max()) + (text.front() == '-')) {
+    Error(token.loc, "debug addend exceeds signed i64");
+    return Result::Error;
+  }
+  *result = text.front() == '-' ? int64_t(uint64_t(0) - magnitude) : int64_t(magnitude);
+  return Result::Ok;
+}
+
+Result WastParser::ParseDebugAnchor(ExprList* exprs) {
+  Location loc = GetLocation();
+  Consume();
+  Var label;
+  CHECK_RESULT(ParseVar(&label));
+  if (!label.is_name()) return ErrorExpected({"debug anchor name"});
+  bool after = false;
+  if (Match(TokenType::Lpar)) {
+    EXPECT(After);
+    EXPECT(End);
+    EXPECT(Rpar);
+    after = true;
+  }
   EXPECT(Rpar);
+  exprs->push_back(std::make_unique<DebugAnchorExpr>(label.name(), after, loc));
+  return Result::Ok;
+}
 
