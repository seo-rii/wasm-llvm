+
+Result BinaryWriter::WriteDebugCustoms() {
+  const auto& customs = module_->customs;
+  auto emit = [&](const Custom& c) {
+    return !(c.name == "target_features" || c.name == "producers" ||
+      (c.name == WABT_BINARY_SECTION_NAME && options_.write_debug_names) ||
+      (c.name.rfind(WABT_BINARY_SECTION_RELOC, 0) == 0 && options_.relocatable) ||
+      (c.name == WABT_BINARY_SECTION_LINKING && options_.relocatable) ||
+      (c.name.find(WABT_BINARY_SECTION_CODE_METADATA) == 0 &&
+       options_.features.code_metadata_enabled()));
+  };
+  // Label declarations are independent of serialization order. For custom
+  // deltas, calculate differences directly so common variable-width prefixes
+  // cancel rather than introducing spurious dependency cycles.
+  std::map<std::string, std::pair<Index, size_t>> custom_labels;
+  for (Index ci = 0; ci < customs.size(); ++ci) {
+    for (size_t ai = 0; ai < customs[ci].atoms.size(); ++ai) {
+      const auto& a = customs[ci].atoms[ai];
+      if (a.kind != CustomAtom::Label) continue;
+      if (!debug_labels_.emplace(a.label, DebugLabel{false, ci, 0}).second)
+        DebugError("duplicate debug label");
+      custom_labels.emplace(a.label, std::make_pair(ci, ai));
+    }
+  }
+  if (debug_error_) return Result::Error;
+  std::vector<std::vector<size_t>> widths(customs.size());
+  std::vector<std::vector<uint8_t>> state(customs.size());
+  for (Index ci = 0; ci < customs.size(); ++ci) {
+    widths[ci].resize(customs[ci].atoms.size());
+    state[ci].resize(customs[ci].atoms.size());
+  }
+  auto encode = [&](const std::string& type, __int128 value,
+                    std::vector<uint8_t>* out) {
+    out->clear();
+    if (type == "uleb") {
+      if (value < 0 || value > __int128(UINT64_MAX)) {
+        DebugError("ULEB delta is negative or exceeds u64"); return;
+      }
+      uint64_t v = uint64_t(value);
+      do { uint8_t byte = v & 127; v >>= 7;
+        out->push_back(byte | (v ? 128 : 0)); } while (v);
+    } else if (type == "sleb") {
+      if (value < INT64_MIN || value > INT64_MAX) {
+        DebugError("SLEB delta exceeds i64"); return;
+      }
+      int64_t v = int64_t(value);
+      for (;;) { uint8_t byte = v & 127; v >>= 7;
+        bool done = (v == 0 && !(byte & 64)) || (v == -1 && (byte & 64));
+        out->push_back(byte | (done ? 0 : 128)); if (done) break; }
+    } else {
+      unsigned bits = type == "i8" ? 8 : type == "i16" ? 16 : type == "i32" ? 32 : 64;
+      if (value < -(__int128(1) << (bits - 1)) || value >= (__int128(1) << bits)) {
+        DebugError("fixed-width delta overflows its slot"); return;
+      }
+      uint64_t v = uint64_t(value);
+      for (unsigned i = 0; i < bits / 8; ++i) { out->push_back(v & 255); v >>= 8; }
+    }
+  };
+  std::function<size_t(Index, size_t)> width;
+  std::function<__int128(const CustomAtom&)> delta;
+  delta = [&](const CustomAtom& a) -> __int128 {
+    auto end = debug_labels_.find(a.label), begin = debug_labels_.find(a.begin);
+    if (end == debug_labels_.end() || begin == debug_labels_.end()) {
+      DebugError("unresolved delta label"); return 0;
+    }
+    auto e = end->second, b = begin->second;
+    if (e.code != b.code || e.owner != b.owner) {
+      DebugError("delta labels have different owners"); return 0;
+    }
+    __int128 value = a.addend;
+    if (e.code) return value + __int128(e.offset) - __int128(b.offset);
+    size_t ei = custom_labels.at(a.label).second;
+    size_t bi = custom_labels.at(a.begin).second;
+    for (size_t i = std::min(ei, bi); i < std::max(ei, bi); ++i)
+      value += (ei >= bi ? 1 : -1) * __int128(width(e.owner, i));
+    return value;
+  };
+  width = [&](Index ci, size_t ai) -> size_t {
+    if (state[ci][ai] == 2) return widths[ci][ai];
+    if (state[ci][ai] == 1) { DebugError("cyclic LEB width dependency"); return 0; }
+    state[ci][ai] = 1;
+    const auto& a = customs[ci].atoms[ai];
+    size_t result = 0;
+    if (a.kind == CustomAtom::Bytes) result = a.bytes.size();
+    else if (a.kind == CustomAtom::Ref) result = 4;
+    else if (a.kind == CustomAtom::Delta) {
+      if (a.width == "uleb" || a.width == "sleb") {
+        std::vector<uint8_t> bytes; encode(a.width, delta(a), &bytes); result = bytes.size();
+      } else result = a.width == "i8" ? 1 : a.width == "i16" ? 2 : a.width == "i32" ? 4 : 8;
+    }
+    state[ci][ai] = 2; widths[ci][ai] = result; return result;
+  };
+  auto custom_offset = [&](Index ci, size_t end) {
+    uint64_t offset = 0;
+    for (size_t ai = 0; ai < end; ++ai) offset += width(ci, ai);
+    return offset;
+  };
+  for (Index ci = 0; ci < customs.size(); ++ci)
+    for (size_t ai = 0; ai < customs[ci].atoms.size(); ++ai) width(ci, ai);
+  if (debug_error_) return Result::Error;
+  custom_symbols_.resize(customs.size(), kInvalidIndex);
+  // Create placeholders only after Code/DataCount/code-metadata layout is
+  // final. Physical custom indices are filled when each payload is emitted.
+  for (const auto& c : customs) for (const auto& a : c.atoms) {
+    if (a.kind != CustomAtom::Ref) continue;
+    if (!options_.relocatable) { DebugError("debug references require relocatable output"); continue; }
+    if (a.reloc.type == RelocType::SectionOffsetI32) {
+      Index target = a.reloc.symbol.index();
+      if (target >= customs.size() || !emit(customs[target])) {
+        DebugError("invalid custom reference target"); continue;
+      }
+      if (custom_symbols_[target] == kInvalidIndex) {
+        custom_symbols_[target] = symtab_.symbols().size();
+        CHECK_RESULT(symtab_.AddSymbol({"", uint32_t(SymbolBinding::Local), Symbol::Section{0}}));
+      }
+    }
+  }
+  if (debug_error_) return Result::Error;
+  for (Index ci = 0; ci < customs.size(); ++ci) {
+    const auto& c = customs[ci];
+    if (!emit(c)) continue;
+    current_custom_name_ = c.name;
+    if (custom_symbols_[ci] != kInvalidIndex)
+      symtab_.symbols()[custom_symbols_[ci]] = Symbol("", uint32_t(SymbolBinding::Local),
+                                                   Symbol::Section{section_count_});
+    BeginCustomSection(c.name.c_str());
+    // LLVM custom relocation offsets start AFTER the encoded custom name.
+    Offset payload_start = stream_->offset();
+    if (!c.structured) stream_->WriteData(c.data, "custom data");
+    else for (size_t ai = 0; ai < c.atoms.size(); ++ai) {
+      const auto& a = c.atoms[ai];
+      if (a.kind == CustomAtom::Bytes) stream_->WriteData(a.bytes, "debug bytes");
+      else if (a.kind == CustomAtom::Delta) {
+        std::vector<uint8_t> bytes; encode(a.width, delta(a), &bytes);
+        stream_->WriteData(bytes, "debug delta");
+      } else if (a.kind == CustomAtom::Ref) {
+        IrReloc reloc = a.reloc;
+        __int128 addend = a.addend, value = 0;
+        Index target = reloc.symbol.index();
+        if (reloc.type == RelocType::SectionOffsetI32 || reloc.type == RelocType::FunctionOffsetI32) {
+          auto found = debug_labels_.find(a.label);
+          bool code = reloc.type == RelocType::FunctionOffsetI32;
+          if (found == debug_labels_.end() || found->second.code != code || found->second.owner != target) {
+            DebugError("reference label has wrong or unresolved owner"); continue;
+          }
+          if (code) {
+            if (target >= function_starts_.size() || function_starts_[target] == UINT64_MAX) {
+              DebugError("text reference requires a defined function"); continue;
+            }
+            addend += found->second.offset;
+            const auto& layout = function_layouts_[target];
+            if (addend != layout.size && std::find(layout.offsets.begin(), layout.offsets.end(), addend) == layout.offsets.end()) {
+              DebugError("text reference is not an instruction boundary"); continue;
+            }
+            value = function_starts_[target] + addend;
+          } else {
+            addend += custom_offset(target, custom_labels.at(a.label).second);
+            if (addend < 0 || addend > custom_offset(target, customs[target].atoms.size()))
+              DebugError("custom reference lies outside target payload");
+            value = addend;
+          }
+        } else if (reloc.type == RelocType::GlobalIndexI32) {
+          if (target >= module_->globals.size()) DebugError("invalid global reference");
+          value = target;
+        } else if (target >= module_->data_symbols.size()) DebugError("invalid data reference");
+        if (addend < INT32_MIN || addend > INT32_MAX) DebugError("relocation addend exceeds i32");
+        if (value < 0 || value > UINT32_MAX) DebugError("reference value exceeds u32");
+        if (debug_error_) return Result::Error;
+        reloc.addend = int32_t(addend);
+        AddRelocAt(reloc, stream_->offset() - payload_start);
+        stream_->WriteU32(uint32_t(value), "debug reference");
+      }
+    }
+    EndSection();
+    if (debug_error_) return Result::Error;
+  }
+  current_custom_name_.clear();
+  return Result::Ok;
+}
