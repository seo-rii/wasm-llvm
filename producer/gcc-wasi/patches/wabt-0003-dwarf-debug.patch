+;; Focused assembler transport fixture. Genuine GCC qualification is separate.
+(module
+  (import "env" "__stack_pointer" (global $__stack_pointer (mut i32)))
+  (func $probe (@sym (name "probe")) (param $p i32) (result i32) (local $tmp i32)
+    (@code.label $LFB0)
+    local.get $p
+    i32.const 127
+    i32.add
+    (@code.label $LM0)
+    local.set $tmp
+    local.get $tmp
+    (@code.label $Lfinal_opcode)
+    (@code.label $LFE0 (after end)))
+
+  (export "probe" (func $probe))
+
+  ;; A minimal CU abbreviation: name=strp, low_pc=addr, high_pc=data4.
+  (@custom $abbrev ".debug_abbrev"
+    (@label $Labbrev0)
+    "\01\11\00\03\0e\11\01\12\06\00\00\00")
+
+  (@custom $strings ".debug_str"
+    (@label $Lname0)
+    "probe\00")
+
+  (@custom $info ".debug_info"
+    (@delta i32 $Lcu_end $Lcu_body)
+    (@label $Lcu_body)
+    "\04\00"                         ;; DWARF version 4
+    (@ref i32 custom $abbrev $Labbrev0)
+    "\04\01"                         ;; address size 4, abbreviation 1
+    (@ref i32 custom $strings $Lname0)
+    (@ref i32 text $probe $LFB0)
+    (@delta i32 $LFE0 $LFB0)
+    (@label $Lcu_end))
+
+  ;; A location-list illustration; a real GCC DIE must reference its offset.
+  (@custom $locations ".debug_loc"
+    (@label $Lloc0)
+    (@ref i32 text $probe $LFB0)
+    (@ref i32 text $probe $LFE0)
+    "\06\00\ed\03"                 ;; expression length 6, global-u32 form
+    (@ref i32 global $__stack_pointer)
+    "\00\00\00\00\00\00\00\00")
+
+  ;; Fresh GCC WAT omits this readback-only assertion. For these illustrative
+  ;; instructions the expected payload has three local-declaration bytes,
+  ;; opcode starts 3,5,8,9,11,13 and exclusive end 14. Body-size LEB is excluded.
+  ;; (@code.layout $probe (offsets 3 5 8 9 11 13) (size 14))
+)
