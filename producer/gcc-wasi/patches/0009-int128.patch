+/* Once public TI storage is enabled, aligned floating aggregates can use
+   an integer pair as their container.  A float view is a bitcast of one
+   word, not a floating local named after the complete TI pseudo.  Normal
+   subregs select a word's lowpart; other field positions are lowered by
+   GCC's integer bitfield machinery before reaching these move patterns.  */
+static bool
+floating_pair_subreg_p (rtx value)
+{
+  return SUBREG_P (value) && REG_P (SUBREG_REG (value))
+    && (GET_MODE (SUBREG_REG (value)) == TImode
+        || GET_MODE (SUBREG_REG (value)) == TFmode)
+    && (GET_MODE (value) == SFmode || GET_MODE (value) == DFmode);
+}
+
+static rtx
+floating_pair_word (rtx value)
+{
+  gcc_assert (floating_pair_subreg_p (value));
+  unsigned byte = SUBREG_BYTE (value).to_constant ();
+  gcc_assert (byte == 0 || byte == 8);
+  rtx base = SUBREG_REG (value);
+  return operand_subword (base, byte / 8, 1, GET_MODE (base));
+}
+
+static rtx
+legalize_floating_pair_source (rtx value)
+{
+  if (!floating_pair_subreg_p (value))
+    return value;
+  machine_mode mode = GET_MODE (value);
+  rtx bits = copy_to_mode_reg (DImode, floating_pair_word (value));
+  if (mode == SFmode)
+    bits = convert_to_mode (SImode, bits, 1);
+  /* Only same-size views of ordinary scalar pseudos reach the existing
+     i64/f64 or i32/f32 reinterpret patterns.  Materialize the float too,
+     so a memory destination still receives a genuine floating register.  */
+  return copy_to_mode_reg (mode, gen_lowpart (mode, bits));
+}
