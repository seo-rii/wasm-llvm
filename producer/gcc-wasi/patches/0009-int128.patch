diff --git a/gcc/config/wasm/wasm-asm.cc b/gcc/config/wasm/wasm-asm.cc
--- a/gcc/config/wasm/wasm-asm.cc
+++ b/gcc/config/wasm/wasm-asm.cc
@@ -129,10 +129,31 @@
 void
 assemble_const_int (FILE *stream, HOST_WIDE_INT value, unsigned size)
 {
+  /* CONST_INT is sign-extended to the requested object width.  In
+     particular, a TI initializer can fit in one HOST_WIDE_INT while its
+     data object still occupies 16 bytes.  Never read past a host-word
+     buffer or shift a host value by its complete bit width.  */
+  unsigned HOST_WIDE_INT bits = (unsigned HOST_WIDE_INT) value;
   char val[sizeof (HOST_WIDE_INT)];
-  for (int i = 0; i != sizeof (HOST_WIDE_INT); ++i)
-    val[i] = value >> (i * 8);
-  assemble_string (stream, val, size, true);
+  unsigned low_size = MIN (size, (unsigned) sizeof (val));
+  for (unsigned i = 0; i != low_size; ++i)
+    {
+      val[i] = bits & 0xff;
+      bits >>= 8;
+    }
+  assemble_string (stream, val, low_size, true);
+
+  if (size > low_size)
+    {
+      memset (val, value < 0 ? 0xff : 0, sizeof (val));
+      unsigned remaining = size - low_size;
+      while (remaining)
+        {
+          unsigned bytes = MIN (remaining, (unsigned) sizeof (val));
+          assemble_string (stream, val, bytes, true);
+          remaining -= bytes;
+        }
+    }
 }
 
