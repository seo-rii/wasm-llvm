+;; but WITHOUT ANY WARRANTY; without even the implied warranty of
+;; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+;; GNU General Public License for more details.
+;;
+;; You should have received a copy of the GNU General Public License
+;; along with GCC; see the file COPYING3.  If not see
+;; <http://www.gnu.org/licenses/>.
+
+;; Arithmetic, conversions and comparisons use GCC's standard TF soft-float
+;; optabs.  No Wasm floating opcode has binary128 precision.  Every TF copy
+;; is lowered here into low/high DI words, without an optimization-pass
+;; dependency or a SIMD requirement.
+(define_expand "movtf"
+  [(set (match_operand:TF 0 "nonimmediate_operand")
+        (match_operand:TF 1 "general_operand"))]
+  ""
+{
+  wasm_expand_pair_move (operands[0], operands[1]);
+  DONE;
+})
+
+;; Generic emit_group_store reconstructs a floating argument in an integer
+;; container before taking a same-size floating view.  Support that storage
+;; operation without enabling TImode in TARGET_SCALAR_MODE_SUPPORTED_P or
+;; advertising any 128-bit integer arithmetic instruction.
+(define_expand "movti"
+  [(set (match_operand:TI 0 "nonimmediate_operand")
+        (match_operand:TI 1 "general_operand"))]
+  ""
+{
+  wasm_expand_pair_move (operands[0], operands[1]);
+  DONE;
+})
+
+(define_expand "negtf2"
+  [(set (match_operand:TF 0 "register_operand")
+        (neg:TF (match_operand:TF 1 "general_operand")))]
+  ""
+{
+  wasm_expand_tf_sign (operands[0], operands[1], NULL_RTX, NEG);
+  DONE;
+})
+
+(define_expand "abstf2"
+  [(set (match_operand:TF 0 "register_operand")
+        (abs:TF (match_operand:TF 1 "general_operand")))]
+  ""
+{
+  wasm_expand_tf_sign (operands[0], operands[1], NULL_RTX, ABS);
+  DONE;
+})
+
+(define_expand "copysigntf3"
+  [(set (match_operand:TF 0 "register_operand")
+        (copysign:TF (match_operand:TF 1 "general_operand")
+                     (match_operand:TF 2 "general_operand")))]
+  ""
+{
+  wasm_expand_tf_sign (operands[0], operands[1], operands[2], COPYSIGN);
+  DONE;
+})
