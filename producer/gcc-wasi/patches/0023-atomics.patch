+/* IPA-reference can move non-address-taken static accesses across a call
+   containing atomic synchronization (GCC PR ipa/80728).  Keep this pass off
+   for the atomics profile, including explicit options and optimize attributes;
+   an RTL memory blockage is too late to repair an earlier GIMPLE hoist.  */
+#define TARGET_OVERRIDE_OPTIONS_AFTER_CHANGE wasm_override_options_after_change
+static void
+wasm_override_options_after_change (void)
+{
+  if (TARGET_ATOMICS)
+    flag_ipa_reference = 0;
+}
+
 #define TARGET_OPTION_OVERRIDE wasm_option_override
 static void
 wasm_option_override (void)
 {
+  wasm_override_options_after_change ();
   /* The Basic C ABI selects direct singleton results and indirect results
      for other aggregates.  The generic PCC default bypasses that hook. */
   flag_pcc_struct_return = 0;
