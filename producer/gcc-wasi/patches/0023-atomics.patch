index 0000000000000000000000000000000000000000..35a65739589fccadfa192bce9f456c435fdc189a
--- /dev/null
+++ b/gcc/config/wasm/atomics.md
@@ -0,0 +1,262 @@
+;; Opt-in WebAssembly atomic memory operations.
+;; Copyright (C) 2026 wasm-llvm contributors.
+;; This file is part of GCC and is distributed under the GNU General Public
+;; License, version 3 or later.  See COPYING3 for details.
+;;
+;; All supported orders use sequentially consistent Wasm instructions.  Each
+;; access has a volatile UNSPEC, explicit memory operands, and full compiler
+;; memory blockages.  Unlike the SIMD UNSPECs, these are observable effects.
+;; The typed operations require natural alignment; there is no native TI mode.
+
+(define_c_enum "unspecv" [
+  UNSPECV_ATOMIC_BLOCKAGE
+  UNSPECV_ATOMIC_FENCE
+  UNSPECV_ATOMIC_LOAD
+  UNSPECV_ATOMIC_STORE
+  UNSPECV_ATOMIC_EXCHANGE
+  UNSPECV_ATOMIC_CAS
+  UNSPECV_ATOMIC_ADD
+  UNSPECV_ATOMIC_SUB
+  UNSPECV_ATOMIC_AND
+  UNSPECV_ATOMIC_OR
+  UNSPECV_ATOMIC_XOR
+])
+
+(define_mode_attr atomic_load_suffix
+  [(QI "8_u") (HI "16_u") (SI "") (DI "")])
+(define_mode_attr atomic_store_suffix
+  [(QI "8") (HI "16") (SI "") (DI "")])
+(define_mode_attr atomic_rmw_width
+  [(QI "8") (HI "16") (SI "") (DI "")])
+(define_mode_attr atomic_rmw_suffix
+  [(QI "_u") (HI "_u") (SI "") (DI "")])
+
+(define_int_iterator WASM_ATOMIC_OP
+  [UNSPECV_ATOMIC_ADD UNSPECV_ATOMIC_SUB UNSPECV_ATOMIC_AND
+   UNSPECV_ATOMIC_OR UNSPECV_ATOMIC_XOR])
+(define_int_attr atomic_name
+  [(UNSPECV_ATOMIC_ADD "add") (UNSPECV_ATOMIC_SUB "sub")
+   (UNSPECV_ATOMIC_AND "and") (UNSPECV_ATOMIC_OR "or")
+   (UNSPECV_ATOMIC_XOR "xor")])
+(define_int_attr atomic_code
+  [(UNSPECV_ATOMIC_ADD "PLUS") (UNSPECV_ATOMIC_SUB "MINUS")
+   (UNSPECV_ATOMIC_AND "AND") (UNSPECV_ATOMIC_OR "IOR")
+   (UNSPECV_ATOMIC_XOR "XOR")])
+
+;; Keep non-atomic accesses on their original side even when the source asks
+;; for a weaker order.  The signal-fence optab also uses this compiler barrier.
+(define_insn "memory_blockage"
+  [(unspec_volatile [(const_int 0)] UNSPECV_ATOMIC_BLOCKAGE)
+   (clobber (mem:BLK (scratch)))]
+  "TARGET_ATOMICS"
+  "")
+
+(define_insn "mem_thread_fence"
+  [(unspec_volatile [(match_operand:SI 0 "const_int_operand")]
+                    UNSPECV_ATOMIC_FENCE)
+   (clobber (mem:BLK (scratch)))]
+  "TARGET_ATOMICS"
+  "(atomic.fence)")
+
+(define_expand "atomic_load<mode>"
+  [(match_operand:QHSDI 0 "register_operand")
+   (match_operand:QHSDI 1 "memory_operand")
+   (match_operand:SI 2 "const_int_operand")]
+  "TARGET_ATOMICS"
+{
+  rtx mem = wasm_atomic_memory (operands[1]);
+  rtx value = gen_reg_rtx (<promote_mode>mode);
+  emit_insn (gen_memory_blockage ());
+  emit_insn (gen_wasm_atomic_load<mode> (value, mem, operands[2]));
+  emit_move_insn (operands[0], gen_lowpart (<MODE>mode, value));
+  emit_insn (gen_memory_blockage ());
+  DONE;
+})
+
+(define_insn "wasm_atomic_load<mode>"
+  [(set (match_operand:<promote_mode> 0 "wasm_register_operand")
+        (unspec_volatile:<promote_mode>
+          [(match_operand:QHSDI 1 "memory_operand")
+           (match_operand:SI 2 "const_int_operand")]
+          UNSPECV_ATOMIC_LOAD))]
+  "TARGET_ATOMICS"
+  "(%o0 (<promote_type>.atomic.load<atomic_load_suffix> %m1))")
+
+(define_expand "atomic_store<mode>"
+  [(match_operand:QHSDI 0 "memory_operand")
+   (match_operand:QHSDI 1 "register_operand")
+   (match_operand:SI 2 "const_int_operand")]
+  "TARGET_ATOMICS"
+{
+  rtx mem = wasm_atomic_memory (operands[0]);
+  rtx value = wasm_atomic_value (operands[1], <MODE>mode);
+  emit_insn (gen_memory_blockage ());
+  emit_insn (gen_wasm_atomic_store<mode> (mem, value, operands[2]));
+  emit_insn (gen_memory_blockage ());
+  DONE;
+})
+
+(define_insn "wasm_atomic_store<mode>"
+  [(set (match_operand:QHSDI 0 "memory_operand")
+        (unspec_volatile:QHSDI
+          [(match_operand:<promote_mode> 1 "wasm_register_operand")
+           (match_operand:SI 2 "const_int_operand")]
+          UNSPECV_ATOMIC_STORE))]
+  "TARGET_ATOMICS"
+  "(<promote_type>.atomic.store<atomic_store_suffix> %m0 %i1)")
+
+(define_expand "atomic_exchange<mode>"
+  [(match_operand:QHSDI 0 "register_operand")
+   (match_operand:QHSDI 1 "memory_operand")
+   (match_operand:QHSDI 2 "register_operand")
+   (match_operand:SI 3 "const_int_operand")]
+  "TARGET_ATOMICS"
+{
+  rtx mem = wasm_atomic_memory (operands[1]);
+  rtx value = wasm_atomic_value (operands[2], <MODE>mode);
+  rtx old = gen_reg_rtx (<promote_mode>mode);
+  emit_insn (gen_memory_blockage ());
+  emit_insn (gen_wasm_atomic_exchange<mode> (old, mem, value, operands[3]));
+  emit_move_insn (operands[0], gen_lowpart (<MODE>mode, old));
+  emit_insn (gen_memory_blockage ());
+  DONE;
+})
+
+(define_insn "wasm_atomic_exchange<mode>"
+  [(set (match_operand:<promote_mode> 0 "wasm_register_operand")
+        (unspec_volatile:<promote_mode>
+          [(match_operand:QHSDI 1 "memory_operand")
+           (match_operand:<promote_mode> 2 "wasm_register_operand")
+           (match_operand:SI 3 "const_int_operand")]
+          UNSPECV_ATOMIC_EXCHANGE))
+   (set (match_dup 1)
+        (unspec_volatile:QHSDI [(match_dup 1) (match_dup 2) (match_dup 3)]
+                              UNSPECV_ATOMIC_EXCHANGE))]
+  "TARGET_ATOMICS"
+  "(%o0 (<promote_type>.atomic.rmw<atomic_rmw_width>.xchg<atomic_rmw_suffix> %m1 %i2))")
+
+(define_expand "atomic_compare_and_swap<mode>"
+  [(match_operand:SI 0 "register_operand")
+   (match_operand:QHSDI 1 "register_operand")
+   (match_operand:QHSDI 2 "memory_operand")
+   (match_operand:QHSDI 3 "register_operand")
+   (match_operand:QHSDI 4 "register_operand")
+   (match_operand:SI 5 "const_int_operand")
+   (match_operand:SI 6 "const_int_operand")
+   (match_operand:SI 7 "const_int_operand")]
+  "TARGET_ATOMICS"
+{
+  rtx mem = wasm_atomic_memory (operands[2]);
+  /* Widen both expected and returned narrow values without sign extension.
+     Wasm returns zero-extended QI/HI values; comparing a signed promotion of
+     expected would report false after a successful high-bit exchange.  */
+  rtx expected = wasm_atomic_value (operands[3], <MODE>mode);
+  rtx desired = wasm_atomic_value (operands[4], <MODE>mode);
+  rtx old = gen_reg_rtx (<promote_mode>mode);
+  emit_insn (gen_memory_blockage ());
+  emit_insn (gen_wasm_atomic_cas<mode> (old, mem, expected, desired,
+                                      operands[6], operands[7]));
+  wasm_expand_compare (<promote_mode>mode, operands[0],
+                       gen_rtx_EQ (SImode, old, expected));
+  emit_move_insn (operands[1], gen_lowpart (<MODE>mode, old));
+  emit_insn (gen_memory_blockage ());
+  /* Implement weak requests with the strong Wasm compare-exchange.  The
+     generic expander updates *expected with operand 1 after failure.  */
+  DONE;
+})
+
+(define_insn "wasm_atomic_cas<mode>"
+  [(set (match_operand:<promote_mode> 0 "wasm_register_operand")
+        (unspec_volatile:<promote_mode>
+          [(match_operand:QHSDI 1 "memory_operand")
+           (match_operand:<promote_mode> 2 "wasm_register_operand")
+           (match_operand:<promote_mode> 3 "wasm_register_operand")
+           (match_operand:SI 4 "const_int_operand")
+           (match_operand:SI 5 "const_int_operand")]
+          UNSPECV_ATOMIC_CAS))
+   (set (match_dup 1)
+        (unspec_volatile:QHSDI
+          [(match_dup 1) (match_dup 2) (match_dup 3)
+           (match_dup 4) (match_dup 5)] UNSPECV_ATOMIC_CAS))]
+  "TARGET_ATOMICS"
+  "(%o0 (<promote_type>.atomic.rmw<atomic_rmw_width>.cmpxchg<atomic_rmw_suffix> %m1 %i2 %i3))")
+
+(define_expand "atomic_fetch_<atomic_name><mode>"
+  [(set (match_operand:QHSDI 0 "register_operand")
+        (unspec_volatile:QHSDI
+          [(match_operand:QHSDI 1 "memory_operand")
+           (match_operand:QHSDI 2 "register_operand")
+           (match_operand:SI 3 "const_int_operand")]
+          WASM_ATOMIC_OP))]
+  "TARGET_ATOMICS"
+{
+  rtx mem = wasm_atomic_memory (operands[1]);
+  rtx value = wasm_atomic_value (operands[2], <MODE>mode);
+  rtx old = gen_reg_rtx (<promote_mode>mode);
+  emit_insn (gen_memory_blockage ());
+  emit_insn (gen_wasm_atomic_fetch_<atomic_name><mode>
+               (old, mem, value, operands[3]));
+  emit_move_insn (operands[0], gen_lowpart (<MODE>mode, old));
+  emit_insn (gen_memory_blockage ());
+  DONE;
+})
+
+(define_insn "wasm_atomic_fetch_<atomic_name><mode>"
+  [(set (match_operand:<promote_mode> 0 "wasm_register_operand")
+        (unspec_volatile:<promote_mode>
+          [(match_operand:QHSDI 1 "memory_operand")
+           (match_operand:<promote_mode> 2 "wasm_register_operand")
+           (match_operand:SI 3 "const_int_operand")]
+          WASM_ATOMIC_OP))
+   (set (match_dup 1)
+        (unspec_volatile:QHSDI [(match_dup 1) (match_dup 2) (match_dup 3)]
+                              WASM_ATOMIC_OP))]
+  "TARGET_ATOMICS"
+  "(%o0 (<promote_type>.atomic.rmw<atomic_rmw_width>.<atomic_name><atomic_rmw_suffix> %m1 %i2))")
+
+(define_expand "atomic_<atomic_name>_fetch<mode>"
+  [(set (match_operand:QHSDI 0 "register_operand")
+        (unspec_volatile:QHSDI
+          [(match_operand:QHSDI 1 "memory_operand")
+           (match_operand:QHSDI 2 "register_operand")
+           (match_operand:SI 3 "const_int_operand")]
+          WASM_ATOMIC_OP))]
+  "TARGET_ATOMICS"
+{
+  rtx mem = wasm_atomic_memory (operands[1]);
+  rtx value = wasm_atomic_value (operands[2], <MODE>mode);
+  rtx old = gen_reg_rtx (<promote_mode>mode);
+  emit_insn (gen_memory_blockage ());
+  emit_insn (gen_wasm_atomic_fetch_<atomic_name><mode>
+               (old, mem, value, operands[3]));
+  rtx next = expand_simple_binop (<promote_mode>mode, <atomic_code>,
+                                 old, value, NULL_RTX, true, OPTAB_DIRECT);
+  gcc_assert (next);
+  emit_move_insn (operands[0], gen_lowpart (<MODE>mode, next));
+  emit_insn (gen_memory_blockage ());
+  DONE;
+})
+
+;; Wasm has no NAND instruction.  Use an atomic initial load and native CAS
+;; loop rather than falling back to a non-atomic helper or a wider access.
+(define_expand "atomic_fetch_nand<mode>"
+  [(match_operand:QHSDI 0 "register_operand")
+   (match_operand:QHSDI 1 "memory_operand")
+   (match_operand:QHSDI 2 "register_operand")
+   (match_operand:SI 3 "const_int_operand")]
+  "TARGET_ATOMICS"
+{
+  wasm_expand_atomic_nand (operands, <MODE>mode, false);
+  DONE;
+})
+
+(define_expand "atomic_nand_fetch<mode>"
+  [(match_operand:QHSDI 0 "register_operand")
+   (match_operand:QHSDI 1 "memory_operand")
+   (match_operand:QHSDI 2 "register_operand")
+   (match_operand:SI 3 "const_int_operand")]
+  "TARGET_ATOMICS"
+{
+  wasm_expand_atomic_nand (operands, <MODE>mode, true);
+  DONE;
+})
