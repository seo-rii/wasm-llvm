 }
 
+/* At -O0 a static address can already be in a pseudo by the time the atomic
+   expander sees it.  Look through its nearest constant definition for the
+   alignment diagnostic only.  Do not cross control flow, calls, another
+   definition, or the bounded search window.  Generated expanders push nested
+   instruction sequences, so inspect their parents as well as the current one.
+   A non-constant definition remains an unknown runtime pointer.  */
+static rtx
+wasm_atomic_address_constant (rtx value)
+{
+  if (!REG_P (value) || REGNO (value) < FIRST_PSEUDO_REGISTER)
+    return value;
+  unsigned remaining = 64;
+  for (sequence_stack *seq = get_current_sequence (); seq; seq = seq->next)
+    for (rtx_insn *insn = seq->last; insn; insn = PREV_INSN (insn))
+      {
+        if (!remaining-- || LABEL_P (insn) || JUMP_P (insn)
+            || CALL_P (insn) || BARRIER_P (insn)
+            || (NOTE_P (insn) && NOTE_KIND (insn) == NOTE_INSN_BASIC_BLOCK))
+          return value;
+        if (NONDEBUG_INSN_P (insn) && reg_set_p (value, insn))
+          {
+            rtx set = single_set (insn);
+            if (set && rtx_equal_p (SET_DEST (set), value)
+                && CONSTANT_P (SET_SRC (set)))
+              return SET_SRC (set);
+            return value;
+          }
+      }
+  return value;
+}
+
+/* Typed atomic builtins follow their natural-alignment precondition.  The
+   generic builtin expander raises MEM_ALIGN to the mode alignment, so that
+   field alone cannot diagnose an incorrectly cast pointer.  Diagnose an
+   address whose known aligned base and constant displacement prove otherwise;
+   dynamically supplied typed pointers remain the caller's responsibility.
+   Generic size-and-void-pointer libatomic entry points have a separate,
+   alignment-aware runtime implementation.  */
+rtx
+wasm_atomic_memory (rtx mem)
+{
+  gcc_assert (TARGET_ATOMICS && MEM_P (mem));
+  unsigned bytes = GET_MODE_SIZE (GET_MODE (mem));
+  gcc_assert (bytes == 1 || bytes == 2 || bytes == 4 || bytes == 8);
+  rtx base = XEXP (mem, 0);
+  HOST_WIDE_INT offset = 0;
+  for (unsigned depth = 0; depth != 4; ++depth)
+    {
+      base = wasm_atomic_address_constant (base);
+      if (GET_CODE (base) == CONST)
+        base = XEXP (base, 0);
+      if (GET_CODE (base) != PLUS || !CONST_INT_P (XEXP (base, 1)))
+        break;
+      offset += INTVAL (XEXP (base, 1));
+      base = XEXP (base, 0);
+    }
+  bool aligned_base = false;
+  if (CONST_INT_P (base))
+    {
+      offset += INTVAL (base);
+      aligned_base = true;
+    }
+  else if (SYMBOL_REF_P (base) && SYMBOL_REF_DECL (base)
+           && DECL_P (SYMBOL_REF_DECL (base)))
+    aligned_base = DECL_ALIGN (SYMBOL_REF_DECL (base)) >= bytes * BITS_PER_UNIT;
+  else if (REG_P (base) && REG_POINTER (base))
+    aligned_base = REGNO_POINTER_ALIGN (REGNO (base)) >= bytes * BITS_PER_UNIT;
+  if (aligned_base && (offset & (bytes - 1)))
+    error ("WebAssembly typed atomic access requires natural %u-byte alignment; "
+           "use the generic libatomic interface for unaligned storage", bytes);
+
+  mem = unify_mem (mem);
+  MEM_VOLATILE_P (mem) = 1;
+  return mem;
+}
+
+/* Native subword operations consume i32 values and return unsigned i32
+   values.  Mask the logical QI/HI operand independently of the signedness or
+   register mode chosen by the preceding C/C++ expression.  In particular,
+   CAS success must compare equal for expected values with their high bit set.  */
+rtx
+wasm_atomic_value (rtx value, machine_mode mode)
+{
+  machine_mode reg_mode = mode == DImode ? DImode : SImode;
+  value = convert_modes (reg_mode, mode, value, true);
+  return force_reg (reg_mode, value);
+}
+
+/* Both NAND result conventions use a naturally aligned atomic initial load,
+   then strong native CAS.  Every retry uses the actual value returned by CAS;
+   no plain load or non-atomic provider participates in the update.  */
+void
+wasm_expand_atomic_nand (rtx *operands, machine_mode mode, bool after)
+{
+  rtx mem = wasm_atomic_memory (operands[1]);
+  machine_mode reg_mode = mode == DImode ? DImode : SImode;
+  rtx value = wasm_atomic_value (operands[2], mode);
+  rtx current = expand_atomic_load (NULL_RTX, mem, MEMMODEL_SEQ_CST);
+  gcc_assert (current);
+  rtx_code_label *retry = gen_label_rtx ();
+  emit_label (retry);
+  rtx expected = copy_to_mode_reg (mode, current);
+  rtx wide = wasm_atomic_value (expected, mode);
+  rtx next = expand_simple_binop (reg_mode, AND, wide, value, NULL_RTX,
+                                 true, OPTAB_DIRECT);
+  gcc_assert (next);
+  next = expand_simple_unop (reg_mode, NOT, next, NULL_RTX, true);
+  gcc_assert (next);
+  next = gen_lowpart (mode, next);
+  rtx success = NULL_RTX, previous = current;
+  bool emitted = expand_atomic_compare_and_swap
+    (&success, &previous, mem, expected, next, false,
+     MEMMODEL_SEQ_CST, MEMMODEL_SEQ_CST);
+  gcc_assert (emitted);
+  if (previous != current)
+    emit_move_insn (current, previous);
+  emit_cmp_and_jump_insns (success, const0_rtx, EQ, const0_rtx,
+                           SImode, true, retry,
+                           profile_probability::guessed_never ());
+  emit_move_insn (operands[0], after ? next : expected);
+}
+
 machine_mode
 wasm_real_register_mode (rtx reg)
 {
