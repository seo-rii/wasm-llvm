+  "(%o0 (<lanes>.<irelop:opname> %i1 %i2))")
+
+;; Wasm has signed i64x2 relational comparisons, but no unsigned ones.
+(define_insn "*simd_compare_<frelop:opname_rt>v2di"
+  [(set (match_operand:V2DI 0 "wasm_register_operand")
+        (frelop:V2DI (match_operand:V2DI 1 "wasm_register_operand")
+                    (match_operand:V2DI 2 "wasm_register_operand")))]
