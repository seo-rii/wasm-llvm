+/* Implement fixed-width constant permutations using the byte shuffle.
+   GCC supplies element indices; Wasm's immediate indexes bytes from the
+   concatenated inputs.  No runtime index is accepted by this hook.  */
+#define TARGET_VECTORIZE_VEC_PERM_CONST wasm_vec_perm_const
+static bool
+wasm_vec_perm_const (machine_mode mode, machine_mode op_mode, rtx output,
+                     rtx in0, rtx in1, const vec_perm_indices &sel)
+{
+  if (mode != op_mode || !wasm_vector_mode_supported_p (mode)
+      || !known_eq (sel.length (), GET_MODE_NUNITS (mode)))
+    return false;
+  if (!output)
+    return true;
+
+  unsigned bytes = GET_MODE_UNIT_SIZE (mode);
+  rtvec indices = rtvec_alloc (16);
+  for (unsigned i = 0; i != 16 / bytes; ++i)
+    {
+      unsigned lane = sel[i].to_constant ();
+      gcc_assert (lane < 32 / bytes);
+      for (unsigned j = 0; j != bytes; ++j)
+        RTVEC_ELT (indices, i * bytes + j) = GEN_INT (lane * bytes + j);
+    }
+  rtx a = force_reg (V16QImode, gen_lowpart (V16QImode, in0));
+  rtx b = force_reg (V16QImode, gen_lowpart (V16QImode, in1));
+  rtx result = gen_reg_rtx (V16QImode);
+  emit_insn (gen_wasm_shuffle_v16qi
+    (result, a, b, gen_rtx_CONST_VECTOR (V16QImode, indices)));
+  emit_move_insn (output, gen_lowpart (mode, result));
+  return true;
+}
