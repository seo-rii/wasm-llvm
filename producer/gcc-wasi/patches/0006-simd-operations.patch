+/* Expand SIMD lane comparisons without losing IEEE unordered semantics.
+   The result has integer lanes, each either all ones or all zeros.  */
+void
+wasm_expand_simd_compare (rtx res, rtx_code code, rtx left, rtx right)
+{
+  machine_mode mode = GET_MODE (res);
+  machine_mode input_mode = GET_MODE (left);
+  left = force_reg (input_mode, left);
+  right = force_reg (input_mode, right);
+
+  if (input_mode == V2DImode
+      && (code == LTU || code == LEU || code == GTU || code == GEU))
+    {
+      /* Bias both unsigned lanes into signed order.  */
+      rtx bias = force_reg (mode, gen_const_vec_duplicate
+        (mode, gen_int_mode (HOST_WIDE_INT_MIN, DImode)));
+      rtx a = gen_reg_rtx (mode), b = gen_reg_rtx (mode);
+      emit_insn (gen_rtx_SET (a, gen_rtx_XOR (mode, left, bias)));
+      emit_insn (gen_rtx_SET (b, gen_rtx_XOR (mode, right, bias)));
+      left = a;
+      right = b;
+      code = signed_condition (code);
+    }
+
+  switch (code)
+    {
+    case ORDERED:
+    case LTGT:
+      {
+        rtx a = gen_reg_rtx (mode), b = gen_reg_rtx (mode);
+        if (code == ORDERED)
+          {
+            wasm_expand_simd_compare (a, EQ, left, left);
+            wasm_expand_simd_compare (b, EQ, right, right);
+            emit_insn (gen_rtx_SET (res, gen_rtx_AND (mode, a, b)));
+          }
+        else
+          {
+            wasm_expand_simd_compare (a, LT, left, right);
+            wasm_expand_simd_compare (b, GT, left, right);
+            emit_insn (gen_rtx_SET (res, gen_rtx_IOR (mode, a, b)));
+          }
+        return;
+      }
+    case UNLT:
+    case UNGT:
+    case UNLE:
+    case UNGE:
+    case UNEQ:
+    case UNORDERED:
+      {
+        rtx a = gen_reg_rtx (mode);
+        wasm_expand_simd_compare (a, reverse_condition_maybe_unordered (code),
+                                  left, right);
+        emit_insn (gen_rtx_SET (res, gen_rtx_NOT (mode, a)));
+        return;
+      }
+    case EQ:
+    case NE:
+    case LT:
+    case LE:
+    case GT:
+    case GE:
+    case LTU:
+    case LEU:
+    case GTU:
+    case GEU:
+      emit_insn (gen_rtx_SET (res, gen_rtx_fmt_ee (code, mode, left, right)));
+      return;
+    default:
+      gcc_unreachable ();
+    }
+}
