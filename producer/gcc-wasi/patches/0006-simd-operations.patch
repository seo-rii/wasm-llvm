+  "(%o0 (i64x2.<frelop:opname> %i1 %i2))")
+
+(define_insn "*simd_compare_<frelop:opname_rt><mode>"
+  [(set (match_operand:<VMASK> 0 "wasm_register_operand")
+        (frelop:<VMASK> (match_operand:VF128 1 "wasm_register_operand")
+                       (match_operand:VF128 2 "wasm_register_operand")))]
