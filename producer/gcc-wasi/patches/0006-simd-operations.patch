+;; Scalar-count shifts have the scalar count in i32, as required by Wasm.
+;; The source language only defines counts smaller than the lane width.
+(define_code_iterator vshift [ashift ashiftrt lshiftrt])
+(define_insn "<vshift:opname_rt><mode>3"
+  [(set (match_operand:VI128 0 "wasm_register_operand")
+        (vshift:VI128 (match_operand:VI128 1 "wasm_register_operand")
+                     (match_operand:SI 2 "wasm_register_operand")))]
+  "TARGET_SIMD128"
+  "(%o0 (<lanes>.<vshift:opname> %i1 %i2))")
+
+(define_mode_attr VMASK [(V16QI "V16QI") (V8HI "V8HI") (V4SI "V4SI")
+  (V2DI "V2DI") (V4SF "V4SI") (V2DF "V2DI")])
+(define_mode_attr vmask [(V16QI "v16qi") (V8HI "v8hi") (V4SI "v4si")
+  (V2DI "v2di") (V4SF "v4si") (V2DF "v2di")])
+
+;; Vector comparisons produce an all-ones or all-zeros integer lane mask.
+(define_expand "vec_cmp<mode><vmask>"
+  [(set (match_operand:<VMASK> 0 "wasm_register_operand")
+        (match_operator 1 "comparison_operator"
+          [(match_operand:V128 2 "wasm_register_operand")
+           (match_operand:V128 3 "wasm_register_operand")]))]
+  "TARGET_SIMD128"
+{
+  wasm_expand_simd_compare (operands[0], GET_CODE (operands[1]),
+                            operands[2], operands[3]);
+  DONE;
+})
+
+(define_expand "vec_cmpu<mode><mode>"
+  [(set (match_operand:VI128 0 "wasm_register_operand")
+        (match_operator 1 "comparison_operator"
+          [(match_operand:VI128 2 "wasm_register_operand")
+           (match_operand:VI128 3 "wasm_register_operand")]))]
+  "TARGET_SIMD128"
+{
+  wasm_expand_simd_compare (operands[0], GET_CODE (operands[1]),
+                            operands[2], operands[3]);
+  DONE;
+})
+
+(define_mode_iterator VICMP128 [V16QI V8HI V4SI])
