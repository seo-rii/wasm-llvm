+/* Keep TLS addresses out of ordinary absolute-symbol address patterns.
+   A TLS address has the same per-thread identity across calls, but is not
+   the link-time address of the template in shared linear memory.  */
+bool
+wasm_tls_address_p (rtx x)
+{
+  if (GET_CODE (x) == CONST)
+    x = XEXP (x, 0);
+  if (GET_CODE (x) == PLUS && CONST_INT_P (XEXP (x, 1)))
+    x = XEXP (x, 0);
+  return SYMBOL_REF_P (x)
+    && SYMBOL_REF_TLS_MODEL (x) != TLS_MODEL_NONE
+    && SYMBOL_REF_TLS_MODEL (x) != TLS_MODEL_EMULATED;
+}
+
 static bool
 expand_const (rtx dest, rtx src, machine_mode mode)
 {
+  if (wasm_tls_address_p (src))
+    {
+      rtx symbol = GET_CODE (src) == CONST ? XEXP (src, 0) : src;
+      if (GET_CODE (symbol) == PLUS)
+	symbol = XEXP (symbol, 0);
+      if (!TARGET_TLS || SYMBOL_REF_TLS_MODEL (symbol) != TLS_MODEL_LOCAL_EXEC)
+	{
+	  error ("WebAssembly TLS address requires %<-mtls%> and the local-exec model");
+	  emit_insn (gen_rtx_SET (dest, const0_rtx));
+	  return true;
+	}
+      gcc_assert (mode == SImode);
+      emit_insn (gen_wasm_tls_address (dest, src));
+      return true;
+    }
   if (!const_int_operand (src, mode) && !const_double_operand (src, mode)
       && !(TARGET_SIMD128 && GET_CODE (src) == CONST_VECTOR)
       && GET_CODE (src) != LABEL_REF && !symref_p (src))
@@ -457,6 +487,11 @@ wasm_expand_mov (rtx dest, rtx src, machine_mode mode)
     }
   dest = unify_mem (dest);
   src = unify_mem (src);
+  /* TLS constants deliberately fail immediate_operand so that optimizers
+     cannot select an absolute-symbol move.  Expand their runtime address
+     explicitly before the ordinary constant path.  */
+  if (register_operand (dest, mode) && wasm_tls_address_p (src))
+    return expand_const (dest, src, mode);
   if (register_operand (dest, mode) && immediate_operand (src, mode))
     return expand_const (dest, src, mode);
   gcc_assert (REG_P (dest) || MEM_P (dest) || SUBREG_P (dest));
