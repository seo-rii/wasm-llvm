+;; Copyright (C) 2026 wasm-llvm contributors.
+;; This file is part of GCC and is distributed under the GNU General Public
+;; License, version 3 or later.  See COPYING3 for details.
+;;
+;; Static wasm32 TLS addresses use a per-instance mutable Wasm global.
+;; The host sets that global through __wasm_init_tls before entering guest
+;; code.  It cannot change during guest execution in this static TLS ABI.
+(define_c_enum "unspec" [UNSPEC_TLS_ADDRESS])
+
+(define_insn "wasm_tls_address"
+  [(set (match_operand:SI 0 "register_operand")
+	(unspec:SI [(match_operand:SI 1 "wasm_tls_address_operand")]
+		   UNSPEC_TLS_ADDRESS))]
+  "TARGET_TLS"
+  "(%M0.set %0 (i32.add (global.get $__tls_base) %j1))")
