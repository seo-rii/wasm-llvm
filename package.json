{
	"name": "wasm-llvm-producers",
	"version": "0.0.0",
	"private": true,
	"description": "Source-pinned producers for browser-hosted LLVM compiler artifacts",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/seo-rii/wasm-llvm.git"
	},
	"scripts": {
		"check": "node ./scripts/check-repository.mjs",
		"test": "node --test ./test/*.test.mjs ./producer/lldb-browser/test/*.test.mjs ./producer/rust-browser/test/*.test.mjs ./producer/tinygo-browser/test/*.test.mjs ./producer/wamr-browser/test/*.test.mjs && pnpm --dir ./producer/swift-browser test",
		"build:clang": "node ./producer/clang-browser/scripts/build-toolchain.mjs",
		"package:clang": "node ./producer/clang-browser/scripts/package-toolchain.mjs",
		"prepare:clang-release": "node ./producer/clang-browser/scripts/prepare-release.mjs",
		"smoke:clang-artifacts": "node ./producer/clang-browser/scripts/smoke-artifacts.mjs",
		"verify:clang-artifacts": "node ./producer/clang-browser/scripts/verify-artifacts.mjs",
		"prepare:lldb": "node ./producer/lldb-browser/scripts/prepare.mjs",
		"build:lldb": "node ./producer/lldb-browser/scripts/build.mjs",
		"package:lldb": "node ./producer/lldb-browser/scripts/package.mjs",
		"verify:lldb-artifacts": "node ./producer/lldb-browser/scripts/verify.mjs",
		"prepare:wamr": "node ./producer/wamr-browser/scripts/prepare.mjs",
		"build:wamr": "node ./producer/wamr-browser/scripts/build.mjs",
		"package:wamr": "node ./producer/wamr-browser/scripts/package.mjs",
		"verify:wamr-artifacts": "node ./producer/wamr-browser/scripts/verify.mjs",
		"build:cobol": "bash ./producer/cobol-browser/scripts/build.sh",
		"prepare:cobol-release": "node ./producer/cobol-browser/scripts/package-release.mjs",
		"verify:cobol-artifacts": "node ./producer/cobol-browser/scripts/verify-artifacts.mjs",
		"verify:emscripten-lld-artifacts": "node ./producer/emscripten-lld-browser/scripts/verify-artifacts.mjs",
		"build:objective-c": "node ./producer/objective-c-browser/scripts/build.mjs",
		"probe:objective-c:foundation": "node ./producer/objective-c-browser/scripts/probe-foundation.mjs",
		"probe:objective-c:libffi": "node ./producer/objective-c-browser/scripts/probe-libffi.mjs --strict-wasm-backend",
		"receipt:objective-c": "node ./producer/objective-c-browser/scripts/write-receipt.mjs",
		"verify:objective-c-artifacts": "node ./producer/objective-c-browser/scripts/verify-artifacts.mjs",
		"producer:rust:verify": "node ./producer/rust-browser/scripts/producer.mjs verify",
		"producer:rust:prepare": "node ./producer/rust-browser/scripts/producer.mjs prepare",
		"producer:rust:build": "bash ./producer/rust-browser/scripts/build.sh",
		"producer:rust:rebuild": "bash ./producer/rust-browser/scripts/rebuild.sh",
		"producer:rust:container-rebuild": "bash ./producer/rust-browser/scripts/container-rebuild.sh",
		"prepare:tinygo-source": "node ./producer/tinygo-browser/scripts/prepare-source.mjs",
		"verify:tinygo-source": "node ./producer/tinygo-browser/scripts/prepare-source.mjs --verify",
		"build:tinygo-llvm-wasi": "node ./producer/tinygo-browser/scripts/build-llvm-wasi.mjs",
		"build:tinygo-browser": "node ./producer/tinygo-browser/scripts/build-browser-compiler.mjs",
		"build:tinygo-package-graph": "node ./producer/tinygo-browser/scripts/build-package-graph-provider.mjs",
		"accept:tinygo-browser": "node ./producer/tinygo-browser/scripts/accept-browser-compiler.mjs",
		"probe:tinygo-native-split": "node ./producer/tinygo-browser/scripts/probe-native-split-pipeline.mjs",
		"verify:tinygo-artifacts": "node ./producer/tinygo-browser/scripts/verify-artifacts.mjs",
		"sync:tinygo": "node ./producer/tinygo-browser/scripts/sync.mjs",
		"swift:doctor": "node ./producer/swift-browser/scripts/doctor.mjs",
		"swift:test": "pnpm --dir ./producer/swift-browser test",
		"probe:crystal-browser": "node ./producer/crystal-browser/scripts/probe.mjs"
	},
	"devDependencies": {
		"@zip.js/zip.js": "^2.8.23",
		"playwright-core": "^1.59.1"
	},
	"engines": {
		"node": ">=20"
	}
}
